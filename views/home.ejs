<%
  // Pictures for this page. Leave '' to show an empty grey slot.
  // Put the files in public/images/home/ and write the path, e.g. '/images/home/senior-1.jpg'.
  const photos = {
    centre: '/images/home/senior-centre.jpg', // big photo in the middle of the circle
    // ...which spins round to these in turn (public/js/home-centre.js). Men and women take turns.
    centrePool: ['senior-centre', 'centre-7', 'centre-1', 'centre-9', 'centre-3', 'centre-10', 'centre-2', 'centre-6', 'centre-4', 'centre-8', 'centre-5']
      .map((n) => '/images/home/' + n + '.jpg'),
    // six small photos around it, clockwise from the top. Men and women take turns.
    around: [1, 2, 3, 4, 5, 6].map((n) => '/images/home/senior-' + n + '.jpg'),
    seniors: [7, 8].map((n) => '/images/home/senior-' + n + '.jpg'), // Find seniors: the first two faces
    // ...which then take turns changing to these
    seniorsPool: [1, 2, 3, 4, 5, 6, 7, 8].map((n) => '/images/home/senior-' + n + '.jpg').concat('/images/home/senior-centre.jpg')
  };

  // the six small photos sit on the outer ring (40% from the centre), so they never poke
  // past the edge of the screen as the circle turns. Sizes vary a little to look natural.
  const spots = [-90, -30, 30, 90, 150, 210].map(function (angle, i) {
    const rad = angle * Math.PI / 180;
    return { x: 50 + 40 * Math.cos(rad), y: 50 + 40 * Math.sin(rad), size: [18, 15, 17, 13, 18, 14][i] };
  });

  // a senior who has added a photo sees themselves in the middle. Otherwise the page picture stays.
  const centreSrc = currentUser && currentUser.profilePictureUrl ? currentUser.profilePictureUrl : photos.centre;

  // a signed-in senior is welcomed by name, with the name in purple
  const welcomeHeading = currentUser ? t('home.welcome_back', { name: currentUser.firstName() }) : '';
  const highlight = currentUser ? currentUser.firstName() : '';
%>
<%- include('partials/header') %>

<%# a round photo, or an empty grey circle until a picture is added %>
<% function photo(src) { %>
  <% if (src) { %>
    <img src="<%= src %>" alt="" class="h-full w-full rounded-full object-cover">
  <% } else { %>
    <span class="flex h-full w-full items-center justify-center rounded-full bg-mist text-indigo/30">
      <i class="icon-user text-[1.4em]" aria-hidden="true"></i>
    </span>
  <% } %>
<% } %>

<%# the main button, with an arrow %>
<% function bigButton(href, label) { %>
  <a href="<%= href %>" class="btn group"><%= label %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></a>
<% } %>

<%# ================= 1. HERO: who we are, one clear next step =================
   phones: badge and headline, the circle, then the text and buttons. computers: text on the left, circle on the right %>
<%# edge to edge, square corners; the help strip sits on its bottom edge %>
<section class="relative overflow-hidden bg-white">
  <div class="relative mx-auto flex max-w-6xl flex-col px-5 py-8 text-center md:grid md:grid-cols-[1.1fr_1fr] md:items-center md:gap-10 md:px-10 md:py-16 md:text-left">
    <div class="contents md:block">
    <div class="relative order-1">
      <% if (currentUser) { %>
        <h1 class="text-[2.3rem] leading-tight md:text-[3.5rem] md:leading-[1.08]" aria-label="<%= welcomeHeading %>">
          <% const nameWords = highlight.split(' '); welcomeHeading.split(' ').forEach(function (word, i) { const isName = nameWords.some(function (w) { return w && word.includes(w); }); %>
            <span class="welcome-word <%= isName ? 'welcome-name text-indigo' : '' %>" style="animation-delay: <%= 150 + i * 160 %>ms" aria-hidden="true"><%= word %></span>
          <% }) %>
        </h1>
      <% } else { %>
        <h1 class="text-[2.3rem] leading-tight md:text-[3.5rem] md:leading-[1.08]"><%= t('home.hero_title_a') %> <span class="text-indigo"><%= t('home.hero_title_b') %></span></h1>
      <% } %>
    </div>

    <div class="relative order-3">
      <p class="mt-4 text-[1.2rem] text-gray-700 md:text-[1.35rem]"><%= t('home.hero_subtitle') %></p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start">
        <% if (currentUser) { %>
          <a href="/events" class="btn group">
            <%= t('home.find_near') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
        <% } else { %>
          <a href="/signup" class="btn group">
            <%= t('home.join') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
          <a href="/events" class="btn-outline"><%= t('home.browse_events') %></a>
        <% } %>
      </div>

      <ul class="mt-6 grid grid-cols-3 gap-2 text-[0.9rem] font-semibold md:flex md:flex-wrap md:gap-x-7 md:gap-y-2 md:text-[0.98rem]">
        <% [['home.tick_verified', 'icon-shield-check'], ['home.tick_local', 'icon-house'], ['home.tick_booking', 'icon-pointer']].forEach(function (tick) { %>
          <li class="flex flex-col items-center gap-1.5 px-1 py-2.5 leading-tight md:flex-row md:gap-2 md:p-0">
            <i class="<%= tick[1] %> text-[1.2rem] text-indigo md:text-leaf" aria-hidden="true"></i><%= t(tick[0]) %>
          </li>
        <% }) %>
      </ul>
    </div>
    </div>

    <%# the circle of seniors. The rings and small photos turn slowly; each face turns back so it stays upright %>
    <div class="relative order-2 mx-auto mb-1 mt-6 aspect-square w-full max-w-[15rem] md:order-none md:mb-0 md:mt-0 md:max-w-[28rem]" aria-hidden="true">
      <span class="orbit absolute inset-0">
        <span class="absolute inset-[10%] rounded-full border-2 border-amber-300/80"></span>
        <span class="absolute inset-[26%] rounded-full border-2 border-indigo/15"></span>
        <% spots.forEach(function (spot, i) { %>
          <span class="absolute block -translate-x-1/2 -translate-y-1/2 rounded-full bg-white p-0.5 shadow-md text-[0.9rem]"
                style="left: <%= spot.x.toFixed(1) %>%; top: <%= spot.y.toFixed(1) %>%; width: <%= spot.size %>%; height: <%= spot.size %>%;">
            <span class="orbit-upright block h-full w-full"><% photo(photos.around[i]) %></span>
          </span>
        <% }) %>
      </span>
      <%# the middle photo spins round to a new face every few seconds; a senior's own photo stays put %>
      <span class="absolute left-1/2 top-1/2 block h-[36%] w-[36%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white p-1 shadow-lg text-[1.6rem]"<% if (centreSrc === photos.centre) { %> data-centre-pool="<%= JSON.stringify(photos.centrePool) %>"<% } %>>
        <% photo(centreSrc) %>
      </span>
    </div>
  </div>
</section>

<%# ================= 1b. HELP ON SENIORPADI: a moving strip of ways to get help, on the hero's bottom edge (visitors only) ================= %>
<%- include('partials/helpTicker') %>

<%# ================= 2. EVENTS: picture on the left, details and Register on the right =================
   Signed in: recommended, so events like the ones they joined before come first. Visitors: upcoming events, soonest first.
   A visitor who taps an event or Register goes to sign up, then confirms their phone, then is registered. %>
<section id="events" class="mx-auto max-w-5xl scroll-mt-4 px-4 pt-14 md:pt-20">
  <h2 class="text-[1.75rem] md:text-[2.1rem]"><%= currentUser ? t('home.rec_title_user') : t('home.up_title') %></h2>

  <% if (typeof recommended === 'undefined' || recommended.length === 0) { %>
    <p class="mt-6 rounded-card bg-surface p-6 text-gray-700"><%= t('home.soon_empty') %></p>
  <% } else { %>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <% recommended.forEach(function (event) {
           const detailsHref = currentUser ? '/events/' + event.id : '/signup?register=' + event.id + '&from=home'; %>
        <article class="card-outline flex gap-4">
          <%# the flyer is always shown whole, never cropped %>
          <a href="<%= detailsHref %>" class="shrink-0 self-start" tabindex="-1" aria-hidden="true">
            <% if (event.imageUrl) { %>
              <img src="<%= event.imageUrl %>" alt="" loading="lazy" draggable="false" class="aspect-[4/5] w-24 rounded-xl bg-mist object-contain min-[400px]:w-28 sm:w-36">
            <% } else { %>
              <span class="flex aspect-[4/5] w-24 items-center justify-center rounded-xl bg-gradient-to-b from-mist to-indigo/10 text-[2.2rem] text-indigo min-[400px]:w-28 sm:w-36"><i class="<%= categoryIcons[event.category] || 'icon-calendar-days' %>"></i></span>
            <% } %>
          </a>
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <p class="self-start whitespace-nowrap rounded-md bg-amber-bg px-3 py-0.5 text-[0.9rem] font-semibold text-amber-tag"><%= shortDate(event.startsAt) %></p>
            <h3 class="mt-1 text-[1.2rem] font-semibold leading-snug"><a href="<%= detailsHref %>" class="text-ink no-underline hover:underline"><%= event.tTitle || event.title %></a></h3>
            <p class="text-[0.98rem] text-gray-700"><%= formatTime(event.startsAt) %> &middot; <%= event.area ? t('area.' + event.area) : event.locationText %></p>
            <%- include('partials/slotsLeft', { id: event.id, slotsLeft: event.slotsLeft, cls: 'text-[0.98rem]' }) %>
            <div class="mt-auto pt-2">
              <% if (currentUser) { %>
                <form action="/events/<%= event.id %>/register" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="from" value="home">
                  <button aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn min-h-12 w-auto px-6"><%= t('stack.register') %></button>
                </form>
              <% } else if (bookingFor) { %>
                <%- include('partials/bookButton', { event, cls: 'min-h-12 px-6' }) %>
              <% } else { %>
                <a href="<%= detailsHref %>" aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn min-h-12 w-auto px-6"><%= t('stack.register') %></a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="mt-5 flex justify-end">
      <a href="/events" class="btn-quiet group"><%= t('home.see_all_events') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></a>
    </div>
  <% } %>
</section>

<%# ================= 3. FIND SENIORS: two square photos that take turns changing (public/js/home-faces.js) ================= %>
<section class="px-4 pt-16 md:pt-24">
  <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2 md:items-center md:gap-14">
    <div class="grid max-w-lg grid-cols-2 gap-3.5" data-face-pool="<%= JSON.stringify(photos.seniorsPool) %>">
      <% photos.seniors.forEach(function (src) { %>
        <span class="face-slot block aspect-square overflow-hidden rounded-3xl bg-white">
          <img src="<%= src %>" alt="" class="h-full w-full object-cover object-top">
        </span>
      <% }) %>
    </div>
    <div>
      <h2 class="text-[1.75rem] leading-tight md:text-[2.3rem]"><%= t('home.seniors_title') %></h2>
      <p class="mt-4 text-[1.15rem] text-gray-700"><%= t('home.seniors_text') %></p>
      <a href="/find-seniors" class="btn group mt-6">
        <%= t('home.meet_seniors') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<%# ================= 4. CALL SENIORPADI ================= %>
<section class="mx-auto max-w-5xl px-4 pt-12">
  <%# Call SeniorPadi: a thin bar with the call button on the right %>
  <a href="<%= supportTel ? 'tel:' + supportTel : '/call' %>" class="group mt-4 flex items-center gap-3 rounded-md bg-indigo py-3 pl-6 pr-3 text-white no-underline shadow-lg shadow-indigo/25 transition hover:bg-indigo-dark sm:gap-4">
    <span class="min-w-0 flex-1 leading-snug">
      <span class="block font-semibold"><%= t('home.call_strip') %></span>
      <span class="hidden text-[0.95rem] text-white/85 sm:block"><%= t('home.card_call') %></span>
    </span>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-indigo transition group-hover:scale-105">
      <i class="icon-phone" aria-hidden="true"></i>
    </span>
  </a>
  <%# WhatsApp: the WhatsApp logo on the right, and common questions taking turns in the middle
      (public/js/home-whatsapp.js). WhatsApp opens with the message that is showing. %>
  <% if (supportTel) {
       const waMessages = [1, 2, 3, 4].map((n) => t('whatsapp.msg_' + n));
       const waBase = whatsappUrl.split('?')[0]; %>
    <a href="<%= waBase %>?text=<%= encodeURIComponent(waMessages[0]) %>" target="_blank" rel="noopener" data-wa data-wa-base="<%= waBase %>" data-wa-messages="<%= JSON.stringify(waMessages) %>"
       class="group mt-3 flex items-center gap-3 rounded-md border-2 border-leaf bg-white py-3 pl-6 pr-3 text-ink no-underline transition hover:bg-emerald-50 sm:gap-4">
      <span class="min-w-0 flex-1 leading-snug">
        <span class="block font-semibold"><%= t('whatsapp.text_us') %></span>
        <span class="block text-[0.95rem] text-gray-700 transition-opacity duration-300" data-wa-text><%= waMessages[0] %></span>
      </span>
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-leaf text-[1.4rem] text-white transition group-hover:scale-105">
        <i class="icon-whatsapp" aria-hidden="true"></i>
      </span>
    </a>
  <% } %>
</section>

<%# ================= 5. HOW IT WORKS: three short steps ================= %>
<section class="mx-auto max-w-5xl px-4 pt-16 md:pt-24">
  <h2 class="text-center text-[1.75rem] md:text-left md:text-[2.1rem]"><%= t('home.how_title') %></h2>
  <%# flat panels, like printed steps: a small label on top, a big title, one line, then a link.
      The whole panel is the link. Signed in, step 1 goes to their account and step 3 to their registrations. %>
  <% const steps = [
       { title: 'home.step1_title', text: 'home.step1', href: currentUser ? '/account' : '/signup', link: currentUser ? 'home.step1_link_user' : 'home.step1_link' },
       { title: 'home.step2_title', text: 'home.step2', href: '/events', link: 'home.step2_link' },
       { title: 'home.step3_title', text: 'home.step3', href: currentUser ? '/registrations' : '/about', link: currentUser ? 'home.step3_link_user' : 'home.step3_link' }
     ]; %>
  <ol class="mt-8 grid gap-8 md:grid-cols-3 md:gap-10">
    <% steps.forEach(function (step, i) { %>
      <li>
        <a href="<%= step.href %>" class="group flex h-full flex-col border-t-2 border-gray-200 pt-5 text-ink no-underline transition hover:border-ink md:pt-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-mist font-semibold text-ink" aria-hidden="true"><%= i + 1 %></span><span class="sr-only"><%= t('home.step_label', { n: i + 1 }) %></span>
          <span class="mt-3 block text-[1.3rem] font-semibold leading-tight md:mt-4 md:text-[1.6rem]"><%= t(step.title) %></span>
          <span class="mt-1 block text-gray-700 md:mt-2 md:text-[1.05rem]"><%= t(step.text) %></span>
          <span class="mt-auto inline-flex min-h-12 items-center gap-2 pt-1 font-semibold md:pt-6 text-ink group-hover:underline"><%= t(step.link) %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></span>
        </a>
      </li>
    <% }) %>
  </ol>
  <a href="/about" class="mt-6 inline-flex min-h-12 items-center gap-2 font-semibold no-underline"><%= t('home.about_more') %><i class="icon-arrow-right" aria-hidden="true"></i></a>
</section>

<%# ================= 7. READY TO JOIN? (visitors only) ================= %>
<% if (!currentUser) { %>
  <section class="mx-auto max-w-2xl px-4 pt-10 text-center md:pt-14">
    <h2 class="text-[1.75rem] md:text-[2.1rem]"><%= t('home.ready_title') %></h2>
    <p class="mt-3 text-[1.15rem] text-gray-700"><%= t('home.ready_text') %></p>
    <div class="mt-7"><% bigButton('/signup', t('home.join')) %></div>
  </section>
<% } %>

<script src="/js/home-faces.js" defer></script>
<script src="/js/home-centre.js" defer></script>
<script src="/js/slots-live.js" defer></script>
<script src="/js/home-whatsapp.js" defer></script>
<%# just registered from this page: the ticket pop-up opens right here, and Close stays on the home page %>
<% if (typeof justRegistered !== 'undefined' && justRegistered) { %>
  <%- include('partials/registeredPopup', { event: justRegistered.event, ticket: justRegistered.ticket, canVolunteer: justRegistered.canVolunteer, closeHref: '/#events', from: 'home' }) %>
<% } %>
<%- include('partials/footer') %>
