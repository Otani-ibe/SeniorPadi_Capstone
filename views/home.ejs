<%
  // Pictures for this page. Leave '' to show an empty grey slot.
  // Put the files in public/images/home/ and write the path, e.g. '/images/home/senior-1.jpg'.
  const photos = {
    centre: '/images/home/senior-centre.jpg', // big photo in the middle of the circle
    // ...which spins round to these in turn (public/js/home-centre.js). Men and women take turns.
    centrePool: ['senior-centre', 'centre-7', 'centre-1', 'centre-9', 'centre-3', 'centre-10', 'centre-2', 'centre-6', 'centre-4', 'centre-8', 'centre-5']
      .map((n) => '/images/home/' + n + '.jpg'),
    // six small photos around it, clockwise from the top. Men and women take turns.
    around: [1, 2, 3, 4, 5, 6].map((n) => '/images/home/senior-' + n + '.jpg'),
    seniors: [7, 8].map((n) => '/images/home/senior-' + n + '.jpg'), // Find seniors: the first two faces
    // ...which then take turns changing to these
    seniorsPool: [1, 2, 3, 4, 5, 6, 7, 8].map((n) => '/images/home/senior-' + n + '.jpg').concat('/images/home/senior-centre.jpg')
  };

  // the six small photos sit on the outer ring (40% from the centre), so they never poke
  // past the edge of the screen as the circle turns. Sizes vary a little to look natural.
  const spots = [-90, -30, 30, 90, 150, 210].map(function (angle, i) {
    const rad = angle * Math.PI / 180;
    return { x: 50 + 40 * Math.cos(rad), y: 50 + 40 * Math.sin(rad), size: [18, 15, 17, 13, 18, 14][i] };
  });

  // The middle photo keeps changing (public/js/home-centre.js). A signed-in senior who has added a photo starts with
  // themselves, and their own photo stays in the turn. The demo seniors' pictures join the faces too.
  // Other people's own uploaded photos are never shown here.
  const centreOwn = currentUser && currentUser.profilePictureUrl ? currentUser.profilePictureUrl : null;
  const centrePool = (centreOwn ? [centreOwn] : []).concat(photos.centrePool, typeof seniorFaces !== 'undefined' ? seniorFaces : [])
    .filter(function (src, i, all) { return all.indexOf(src) === i; });
  const centreSrc = centreOwn || photos.centre;

  // a signed-in senior is welcomed by name, with the name in purple
  const welcomeHeading = currentUser ? t('home.welcome_back', { name: currentUser.firstName() }) : '';
  const highlight = currentUser ? currentUser.firstName() : '';
%>
<%- include('partials/header') %>

<%# a round photo, or an empty grey circle until a picture is added %>
<% function photo(src) { %>
  <% if (src) { %>
    <img src="<%= src %>" alt="" class="h-full w-full rounded-full object-cover">
  <% } else { %>
    <span class="flex h-full w-full items-center justify-center rounded-full bg-mist text-indigo/30">
      <i class="icon-user text-[1.4em]" aria-hidden="true"></i>
    </span>
  <% } %>
<% } %>

<%# the main button, with an arrow %>
<% function bigButton(href, label) { %>
  <a href="<%= href %>" class="btn group min-h-14 px-7 text-[1.1rem]"><%= label %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></a>
<% } %>

<%# ================= 1. HERO: who we are, one clear next step =================
   phones: badge and headline, the circle, then the text and buttons. computers: text on the left, circle on the right %>
<%# edge to edge, square corners; the help strip sits on its bottom edge %>
<section class="relative overflow-hidden bg-white">
  <div class="relative mx-auto flex max-w-6xl flex-col px-5 py-8 text-center md:grid md:grid-cols-[1.1fr_1fr] md:items-center md:gap-10 md:px-10 md:py-16 md:text-left">
    <div class="contents md:block">
    <div class="relative order-1">
      <% if (currentUser) { %>
        <h1 class="text-[2.3rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[3.5rem]" aria-label="<%= welcomeHeading %>">
          <% const nameWords = highlight.split(' '); welcomeHeading.split(' ').forEach(function (word, i) { const isName = nameWords.some(function (w) { return w && word.includes(w); }); %>
            <span class="welcome-word <%= isName ? 'welcome-name text-indigo' : '' %>" style="animation-delay: <%= 150 + i * 160 %>ms" aria-hidden="true"><%= word %></span>
          <% }) %>
        </h1>
      <% } else { %>
        <h1 class="text-[2.3rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[3.5rem]"><%= t('home.hero_title_a') %> <span class="text-indigo"><%= t('home.hero_title_b') %></span></h1>
      <% } %>
    </div>

    <div class="relative order-3">
      <p class="mt-5 text-[1.2rem] text-slate-600 md:text-[1.35rem]"><%= t('home.hero_subtitle') %></p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start">
        <% if (currentUser) { %>
          <a href="/events" class="btn group min-h-14 px-7 text-[1.1rem]">
            <%= t('home.find_near') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
        <% } else { %>
          <a href="/signup" class="btn group min-h-14 px-7 text-[1.1rem]">
            <%= t('home.join') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
          <a href="/events" class="btn-outline min-h-14 px-7 text-[1.1rem]"><%= t('home.browse_events') %></a>
        <% } %>
      </div>

      <ul class="mt-8 grid grid-cols-3 gap-2 text-[0.9rem] font-semibold text-slate-700 md:flex md:flex-wrap md:gap-3 md:text-[0.98rem]">
        <% [['home.tick_verified', 'icon-shield-check'], ['home.tick_local', 'icon-house'], ['home.tick_booking', 'icon-pointer']].forEach(function (tick) { %>
          <li class="flex flex-col items-center gap-1.5 rounded-2xl bg-white px-1 py-2.5 leading-tight shadow-sm ring-1 ring-slate-100 md:flex-row md:gap-2 md:rounded-full md:px-4 md:py-2">
            <i class="<%= tick[1] %> text-[1.2rem] text-indigo" aria-hidden="true"></i><%= t(tick[0]) %>
          </li>
        <% }) %>
      </ul>
    </div>
    </div>

    <%# the circle of seniors. The rings and small photos turn slowly; each face turns back so it stays upright %>
    <div class="relative order-2 mx-auto mb-1 mt-6 aspect-square w-full max-w-[15rem] md:order-none md:mb-0 md:mt-0 md:max-w-[28rem]" aria-hidden="true">
      <span class="orbit absolute inset-0">
        <span class="absolute inset-[10%] rounded-full border-2 border-amber-300/80"></span>
        <span class="absolute inset-[26%] rounded-full border-2 border-indigo/20"></span>
        <% spots.forEach(function (spot, i) { %>
          <span class="absolute block -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-white shadow-xl md:border-4 text-[0.9rem]"
                style="left: <%= spot.x.toFixed(1) %>%; top: <%= spot.y.toFixed(1) %>%; width: <%= spot.size %>%; height: <%= spot.size %>%;">
            <span class="orbit-upright block h-full w-full"><% photo(photos.around[i]) %></span>
          </span>
        <% }) %>
      </span>
      <%# the middle photo spins round to a new face every few seconds; a senior's own photo stays put %>
      <span class="absolute left-1/2 top-1/2 block h-[36%] w-[36%] -translate-x-1/2 -translate-y-1/2 rounded-full border-4 border-white bg-white shadow-md ring-1 ring-slate-200 text-[1.6rem]"data-centre-pool="<%= JSON.stringify(centrePool) %>">
        <% photo(centreSrc) %>
      </span>
    </div>
  </div>
</section>

<%# ================= 1b. HELP ON SENIORPADI: a moving strip of ways to get help, on the hero's bottom edge (visitors only) ================= %>
<%- include('partials/helpTicker') %>

<%# ================= 2. EVENTS: picture on the left, details and Register on the right =================
   Signed in: recommended, so events like the ones they joined before come first. Visitors: upcoming events, soonest first.
   A visitor who taps an event or Register goes to sign up, then confirms their phone, then is registered. %>
<section id="events" class="mx-auto max-w-6xl scroll-mt-4 px-4 pt-14 md:px-10 md:pt-20">
  <h2 class="text-[1.9rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[2.4rem]"><%= currentUser ? t('home.rec_title_user') : t('home.up_title') %></h2>

  <% if (typeof recommended === 'undefined' || recommended.length === 0) { %>
    <p class="mt-6 rounded-card bg-white p-6 text-slate-600 shadow-md shadow-slate-900/5 ring-1 ring-slate-100"><%= t('home.soon_empty') %></p>
  <% } else { %>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      <% recommended.forEach(function (event) {
           const detailsHref = currentUser ? '/events/' + event.id : '/signup?register=' + event.id + '&from=home'; %>
        <article class="flex flex-col gap-4 rounded-[1.75rem] bg-white p-3 shadow-lg shadow-slate-900/5 ring-1 ring-slate-100 transition duration-200 hover:shadow-md">
          <%# the picture at its own shape: the card fits the flyer, nothing is cut off or padded %>
          <a href="<%= detailsHref %>" class="relative block" tabindex="-1" aria-hidden="true">
            <% if (event.imageUrl) { %>
              <img src="<%= event.imageUrl %>" alt="" loading="lazy" draggable="false" class="mx-auto block h-auto w-auto max-w-full rounded-[1.25rem] max-h-[26rem]">
            <% } else { %>
              <span class="flex aspect-[4/3] w-full items-center justify-center rounded-[1.25rem] bg-mist text-[3rem] text-indigo"><i class="<%= categoryIcons[event.category] || 'icon-calendar-days' %>"></i></span>
            <% } %>
          </a>
          <div class="flex flex-1 flex-col px-2 pb-2">
            <h3 class="text-[1.3rem] font-extrabold leading-snug"><a href="<%= detailsHref %>" class="text-slate-900 no-underline hover:text-indigo hover:underline"><%= event.tTitle || event.title %></a></h3>
            <p class="mt-1 text-slate-600"><%= shortDate(event.startsAt) %> &middot; <%= formatTime(event.startsAt) %> &middot; <%= event.area ? t('area.' + event.area) : event.locationText %></p>
            <p class="mt-2 text-[1rem] leading-snug text-slate-700 line-clamp-2"><%= event.tDescription || event.description %></p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <% if (event.category) { %><span class="tag-outline"><%= t('category.' + event.category) %></span><% } %>
              <%- include('partials/slotsLeft', { id: event.id, slotsLeft: event.slotsLeft, cls: '!py-1 !text-[0.95rem] !font-medium' }) %>
            </div>
            <div class="mt-auto pt-4">
              <% if (currentUser) { %>
                <form action="/events/<%= event.id %>/register" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="from" value="home">
                  <button aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn min-h-14 w-full text-[1.1rem] sm:w-full"><%= t('stack.register') %></button>
                </form>
              <% } else if (bookingFor) { %>
                <%- include('partials/bookButton', { event, cls: 'min-h-14 text-[1.1rem]' }) %>
              <% } else { %>
                <a href="<%= detailsHref %>" aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn min-h-14 w-full text-[1.1rem] sm:w-full"><%= t('stack.register') %></a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="mt-8 flex justify-center md:justify-end">
      <a href="/events" class="group inline-flex min-h-12 items-center gap-2 text-[1.1rem] font-bold text-indigo no-underline hover:underline"><%= t('home.see_all_events') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></a>
    </div>
  <% } %>
</section>

<%# ================= 3. FIND SENIORS: two square photos that take turns changing (public/js/home-faces.js) ================= %>
<section class="px-4 pt-16 md:pt-24">
  <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2 md:items-center md:gap-14">
    <div class="grid max-w-lg grid-cols-2 gap-3.5" data-face-pool="<%= JSON.stringify(photos.seniorsPool) %>">
      <% photos.seniors.forEach(function (src) { %>
        <span class="face-slot block aspect-square overflow-hidden rounded-[1.75rem] bg-white shadow-md ring-4 ring-white">
          <img src="<%= src %>" alt="" class="h-full w-full object-cover object-top">
        </span>
      <% }) %>
    </div>
    <div>
      <h2 class="text-[1.9rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[2.4rem]"><%= t('home.seniors_title') %></h2>
      <p class="mt-4 text-[1.15rem] text-slate-600"><%= t('home.seniors_text') %></p>
      <a href="/find-seniors" class="btn group mt-6 min-h-14 px-7 text-[1.1rem]">
        <%= t('home.meet_seniors') %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<%# ================= 4. CALL SENIORPADI ================= %>
<section class="mx-auto max-w-5xl px-4 pt-12">
  <%# Call SeniorPadi: a thin bar with the call button on the right %>
  <a href="<%= supportTel ? 'tel:' + supportTel : '/call' %>" class="group mt-4 flex items-center gap-3 rounded-[1.25rem] bg-white py-4 pl-6 pr-4 text-ink no-underline shadow-md shadow-slate-900/5 ring-1 ring-slate-100 transition-colors hover:ring-2 hover:ring-indigo sm:gap-4">
    <span class="min-w-0 flex-1 leading-snug">
      <span class="block font-semibold"><%= t('home.call_strip') %></span>
      <span class="hidden text-[0.95rem] text-gray-700 sm:block"><%= t('home.card_call') %></span>
    </span>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo text-white transition group-hover:scale-105">
      <i class="icon-phone" aria-hidden="true"></i>
    </span>
  </a>
  <%# WhatsApp: the WhatsApp logo on the right, and common questions taking turns in the middle
      (public/js/home-whatsapp.js). WhatsApp opens with the message that is showing. %>
  <% if (supportTel) {
       const waMessages = [1, 2, 3, 4].map((n) => t('whatsapp.msg_' + n));
       const waBase = whatsappTextable ? whatsappLink('').split('?')[0] : ''; %>
    <a href="<%= whatsappLink(waMessages[0]) %>" target="_blank" rel="noopener" data-wa data-wa-base="<%= waBase %>" data-wa-messages="<%= JSON.stringify(waMessages) %>"
       class="group mt-3 flex items-center gap-3 rounded-[1.25rem] bg-white py-4 pl-6 pr-4 text-ink no-underline shadow-md shadow-slate-900/5 ring-1 ring-slate-100 transition-colors hover:ring-2 hover:ring-leaf sm:gap-4">
      <span class="min-w-0 flex-1 leading-snug">
        <span class="block font-semibold"><%= t('whatsapp.text_us') %></span>
        <span class="block text-[0.95rem] text-gray-700 transition-opacity duration-300" data-wa-text><%= waMessages[0] %></span>
      </span>
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-leaf text-[1.4rem] text-white transition group-hover:scale-105">
        <i class="icon-whatsapp" aria-hidden="true"></i>
      </span>
    </a>
  <% } %>
</section>

<%# ================= 5. HOW IT WORKS: three short steps ================= %>
<section class="mx-auto max-w-5xl px-4 pt-16 md:pt-24">
  <h2 class="text-center text-[1.9rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-left md:text-[2.4rem]"><%= t('home.how_title') %></h2>
  <%# flat panels, like printed steps: a small label on top, a big title, one line, then a link.
      The whole panel is the link. Signed in, step 1 goes to their account and step 3 to their registrations. %>
  <% const steps = [
       { title: 'home.step1_title', text: 'home.step1', href: currentUser ? '/account' : '/signup', link: currentUser ? 'home.step1_link_user' : 'home.step1_link' },
       { title: 'home.step2_title', text: 'home.step2', href: '/events', link: 'home.step2_link' },
       { title: 'home.step3_title', text: 'home.step3', href: currentUser ? '/registrations' : '/about', link: currentUser ? 'home.step3_link_user' : 'home.step3_link' }
     ]; %>
  <ol class="mt-8 grid gap-8 md:grid-cols-3 md:gap-10">
    <% steps.forEach(function (step, i) { %>
      <li>
        <a href="<%= step.href %>" class="group flex h-full flex-col rounded-[1.5rem] bg-white p-6 text-ink no-underline shadow-md shadow-slate-900/5 ring-1 ring-slate-100 transition duration-200 hover:shadow-md">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-indigo text-[1.1rem] font-bold text-white" aria-hidden="true"><%= i + 1 %></span><span class="sr-only"><%= t('home.step_label', { n: i + 1 }) %></span>
          <span class="mt-3 block text-[1.3rem] font-semibold leading-tight md:mt-4 md:text-[1.6rem]"><%= t(step.title) %></span>
          <span class="mt-1 block text-gray-700 md:mt-2 md:text-[1.05rem]"><%= t(step.text) %></span>
          <span class="mt-auto inline-flex min-h-12 items-center gap-2 pt-1 font-bold md:pt-6 text-indigo group-hover:underline"><%= t(step.link) %><i class="icon-arrow-right transition group-hover:translate-x-1" aria-hidden="true"></i></span>
        </a>
      </li>
    <% }) %>
  </ol>
  <a href="/about" class="mt-6 inline-flex min-h-12 items-center gap-2 font-semibold no-underline"><%= t('home.about_more') %><i class="icon-arrow-right" aria-hidden="true"></i></a>
</section>

<%# ================= 7. READY TO JOIN? (visitors only) ================= %>
<% if (!currentUser) { %>
  <section class="mx-auto max-w-2xl px-4 pb-10 pt-14 text-center md:pt-20">
    <h2 class="text-[1.9rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[2.4rem]"><%= t('home.ready_title') %></h2>
    <p class="mt-3 text-[1.15rem] text-slate-600"><%= t('home.ready_text') %></p>
    <div class="mt-7 flex justify-center"><% bigButton('/signup', t('home.join')) %></div>
  </section>
<% } %>

<script src="/js/home-faces.js" defer></script>
<script src="/js/home-centre.js" defer></script>
<script src="/js/slots-live.js" defer></script>
<script src="/js/home-whatsapp.js" defer></script>
<%# just registered from this page: the ticket pop-up opens right here, and Close stays on the home page %>
<% if (typeof justRegistered !== 'undefined' && justRegistered) { %>
  <%- include('partials/registeredPopup', { event: justRegistered.event, ticket: justRegistered.ticket, canVolunteer: justRegistered.canVolunteer, closeHref: '/#events', from: 'home' }) %>
<% } %>
<%- include('partials/footer') %>
