<!DOCTYPE html>
<%# Emails: tables and inline styles only, so they look right in Gmail, Yahoo and phone mail apps.
    No SVG (many mail apps block it): the logo is a styled letter instead. %>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#f5f4f7;font-family:Arial,Helvetica,sans-serif;color:#1a1523;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f4f7;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:20px;overflow:hidden;">
          <%# header: logo letter and name %>
          <tr>
            <td style="background:#6d28d9;padding:20px 24px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="width:40px;height:40px;background:#ffffff;border-radius:12px;text-align:center;vertical-align:middle;font-size:24px;font-weight:bold;color:#6d28d9;">P</td>
                  <td style="padding-left:12px;font-size:22px;font-weight:bold;color:#ffffff;">SeniorPadi</td>
                </tr>
              </table>
            </td>
          </tr>
          <%# message %>
          <tr>
            <td style="padding:28px 24px 8px;">
              <h1 style="font-size:24px;line-height:1.3;margin:0 0 18px;color:#1a1523;"><%= subject %></h1>
              <% paragraphs.forEach(function (p) { if (p.trim()) { %>
                <p style="font-size:18px;line-height:1.6;margin:0 0 14px;color:#1a1523;"><%= p %></p>
              <% } }) %>
            </td>
          </tr>
          <%# footer %>
          <tr>
            <td style="padding:16px 24px 24px;">
              <p style="font-size:15px;line-height:1.5;color:#4b4558;margin:0;padding-top:14px;border-top:2px solid #f3eeff;"><%= footer %></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
