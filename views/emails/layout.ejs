<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background:#ffffff;font-family:Arial,sans-serif;color:#16213e;">
  <div style="max-width:560px;margin:0 auto;padding:24px;">
    <p style="font-size:22px;font-weight:bold;color:#22407a;margin:0 0 20px;">SeniorPadi</p>
    <h1 style="font-size:22px;margin:0 0 16px;"><%= subject %></h1>
    <% paragraphs.forEach(function (p) { if (p.trim()) { %>
      <p style="font-size:18px;line-height:1.6;margin:0 0 14px;"><%= p %></p>
    <% } }) %>
    <p style="font-size:15px;color:#555;margin-top:28px;border-top:1px solid #ddd;padding-top:14px;"><%= footer %></p>
  </div>
</body>
</html>
