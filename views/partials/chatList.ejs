<%# people you talk to: search box, then a row each with picture, name, last message, time. Beside the chat on wide screens, the Messages screen on phones.
    needs: conversations, unreadIds; activeId (open chat or null). public/js/chat-list.js does the search %>
<% const open = typeof activeId !== 'undefined' ? activeId : null; %>
<aside aria-label="<%= t('messages.title') %>" class="flex min-h-0 w-full shrink-0 flex-col bg-white md:w-80 md:border-r md:border-slate-100 lg:w-96 <%= open ? 'max-md:hidden' : '' %>">
  <div class="shrink-0 px-4 pb-3 pt-5">
    <h1 class="mb-3 text-[1.6rem] font-bold leading-tight"><%= t('messages.title') %> <span class="text-[1.1rem] font-semibold text-gray-700">(<%= conversations.length %>)</span></h1>
    <label for="chat-search" class="sr-only"><%= t('messages.search') %></label>
    <div class="relative">
      <i class="icon-search pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-700" aria-hidden="true"></i>
      <input id="chat-search" type="search" data-chat-search placeholder="<%= t('messages.search') %>" autocomplete="off"
             class="block min-h-12 w-full rounded-full border-0 bg-slate-100 py-2 pl-11 pr-4 text-[1.05rem] placeholder:text-slate-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-indigo/25">
    </div>
  </div>

  <% if (conversations.length === 0) { %>
    <div class="px-6 py-10 text-center">
      <span class="icon-dot-soft mx-auto h-16 w-16 text-[1.5rem]"><i class="icon-messages-square" aria-hidden="true"></i></span>
      <p class="mt-4 text-[1.1rem]"><%= t('messages.none') %></p>
      <a href="/find-seniors" class="btn mt-5"><%= t('nav.find') %><i class="icon-arrow-right" aria-hidden="true"></i></a>
    </div>
  <% } %>

  <ul class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-2 pb-3" data-chat-list>
    <% conversations.forEach(function (c) { const unread = unreadIds.has(c.person.id); const isOpen = open === c.person.id; %>
      <li data-chat-name="<%= c.person.firstName().toLowerCase() %>">
        <a href="/messages/<%= c.person.id %>" <%= isOpen ? 'aria-current=page' : '' %>
           class="flex items-center gap-3 rounded-[1rem] px-3 py-3 no-underline transition hover:bg-slate-50 <%= isOpen ? '!bg-mist' : '' %>">
          <span class="relative shrink-0">
            <%- include('avatar', { person: c.person, cls: 'h-14 w-14' }) %>
            <%- include('presence', { person: c.person, corner: true }) %>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-baseline gap-2">
              <span class="truncate text-[1.1rem] <%= unread ? 'font-bold' : 'font-semibold' %> text-ink"><%= c.person.firstName() %></span>
              <% if (c.last) { %><span class="ml-auto shrink-0 text-[0.9rem] <%= unread ? 'font-semibold text-indigo' : 'text-slate-500' %>"><%= shortDate(c.last.createdAt) %></span><% } %>
            </span>
            <% if (c.last) { %>
            <span class="flex items-center gap-2">
              <span class="block min-w-0 flex-1 truncate text-[1rem] <%= unread ? 'font-semibold text-ink' : 'text-slate-600' %>"><% if (c.last.kind === 'call') { %><i class="icon-phone mr-1" aria-hidden="true"></i><%= t('messages.call_short', { length: callLength(c.last.body) }) %><% } else if (c.last.kind === 'missed_call') { %><i class="icon-phone-missed mr-1" aria-hidden="true"></i><%= c.last.senderId === currentUser.id ? t('messages.call_unanswered_short') : t('messages.call_missed') %><% } else { %><%= c.last.senderId === currentUser.id ? t('messages.you') + ' ' : '' %><%= c.last.body %><% } %></span>
            </span>
            <% } %>
            <%# what is waiting in this conversation %>
            <% if (c.alerts) { %>
              <span class="mt-1 flex flex-wrap items-center gap-1.5" data-chat-alerts>
                <% if (c.alerts.messages > 0) { %><span class="tag-mine shrink-0"><%= c.alerts.messages > 1 ? t('messages.new_count', { n: c.alerts.messages }) : t('messages.new') %></span><% } %>
                <% if (c.alerts.swapRequest) { %><span class="tag-amber shrink-0"><i class="icon-arrow-left-right" aria-hidden="true"></i><%= t('messages.alert_swap_request') %></span><% } %>
                <% if (c.alerts.swapAccepted) { %><span class="tag-leaf shrink-0"><i class="icon-circle-check" aria-hidden="true"></i><%= t('messages.alert_swap_accepted') %></span><% } %>
                <% if (c.alerts.swapDeclined) { %><span class="tag-outline shrink-0"><%= t('messages.alert_swap_declined') %></span><% } %>
              </span>
            <% } %>
          </span>
        </a>
      </li>
    <% }) %>
  </ul>
  <p data-chat-no-results hidden class="px-6 py-6 text-center text-gray-700"><%= t('messages.no_results') %></p>
</aside>
<script src="/js/chat-list.js" defer></script>
