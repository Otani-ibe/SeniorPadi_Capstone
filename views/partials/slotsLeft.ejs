<%# "23 slots left", as a small pill. Shown only when the event has a capacity; hidden when it has none.
    Green normally, red at 5 or fewer. public/js/slots-live.js keeps it up to date.
    needs: id, slotsLeft (a number, or null for no limit); cls (optional) %>
<% const n = typeof slotsLeft === 'undefined' ? null : slotsLeft; %>
<p data-slots-for="<%= id %>" data-one="<%= t('slots.left_one') %>" data-many="<%= t('slots.left', { n: '__N__' }) %>" data-full="<%= t('tag.full') %>"
   class="slots <%= n !== null && n <= 5 ? 'slots-low' : 'slots-ok' %> <%= typeof cls !== 'undefined' ? cls : '' %>" <%= n === null ? 'hidden' : '' %>><i class="icon-ticket" aria-hidden="true"></i><span data-slots-text><%= n === null ? '' : n === 0 ? t('tag.full') : n === 1 ? t('slots.left_one') : t('slots.left', { n }) %></span></p>
