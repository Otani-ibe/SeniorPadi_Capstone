<%# Call and WhatsApp buttons, they open the phone app or WhatsApp, never another page.
    needs: callLabel, whatsappLabel. Nothing shows until a support number is set (SUPPORT_PHONE) %>
<% if (supportTel) { %>
  <div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
    <a href="tel:<%= supportTel %>" class="btn-plain min-h-12">
      <i class="icon-phone text-indigo" aria-hidden="true"></i><%= callLabel %>
    </a>
    <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="btn-plain min-h-12">
      <i class="icon-whatsapp text-[1.2rem] text-leaf" aria-hidden="true"></i><%= whatsappLabel %>
    </a>
  </div>
<% } %>
