<%# staff sidebar (left on computers, a scrolling bar on phones), in labelled groups %>
<%
  const groups = [
    { label: 'Main', links: [
      { href: '/admin', label: 'Dashboard', icon: 'dashboard' },
      { href: '/admin/events', label: 'Events', icon: 'calendar' },
      { href: '/admin/organizations', label: 'Organizations', icon: 'building' }
    ] },
    { label: 'People', links: [
      { href: '/admin/seniors', label: 'Seniors', icon: 'users' },
      { href: '/admin/ids', label: 'ID checks', icon: 'id-card' },
      { href: '/admin/reports', label: 'Reports', icon: 'flag' }
    ] },
    { label: 'Settings', links: [
      { href: '/admin/staff', label: 'Staff', icon: 'shield' },
      { href: '/admin/system', label: 'System', icon: 'sliders' }
    ] }
  ];
%>
<aside class="border-b border-gray-200 bg-white md:sticky md:top-0 md:flex md:h-screen md:w-60 md:shrink-0 md:flex-col md:border-b-0 md:border-r">
  <div class="flex items-center justify-between gap-3 px-5 py-4 md:py-6">
    <a href="/admin" class="logo flex items-center gap-2 text-[1.2rem] font-bold tracking-tight text-ink no-underline">
      <%- include('logoMark', { size: 'h-8 w-8', uid: 'n' }) %>
      <span class="logo-word">SeniorPadi</span>
    </a>
    <span class="flex items-center gap-2">
      <span class="rounded-md bg-mist px-2 py-0.5 text-[0.75rem] font-semibold text-indigo">Staff</span>
      <form action="/logout" method="post" class="md:hidden">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="flex h-11 w-11 items-center justify-center rounded-md bg-surface text-ink" aria-label="Log out"><%- include('icon', { name: 'log-out', cls: 'h-[1.1rem] w-[1.1rem]' }) %></button>
      </form>
    </span>
  </div>
  <nav aria-label="Admin" class="overflow-x-auto px-3 pb-3 md:flex-1 md:overflow-y-auto">
    <div class="flex gap-1 md:flex-col md:gap-5">
      <% groups.forEach(function (group) { %>
        <div class="md:space-y-1">
          <p class="hidden px-3 text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-gray-500 md:block"><%= group.label %></p>
          <ul class="flex gap-1 md:flex-col">
            <% group.links.forEach(function (link) {
                 const active = currentPath === link.href || (link.href !== '/admin' && currentPath.startsWith(link.href));
            %>
              <li>
                <a href="<%= link.href %>" <%= active ? 'aria-current=page' : '' %>
                   class="flex min-h-11 items-center gap-3 whitespace-nowrap rounded-md px-3 py-2 text-[0.95rem] no-underline transition
                          <%= active ? 'bg-ink font-semibold text-white' : 'font-medium text-gray-700 hover:bg-surface hover:text-ink' %>">
                  <%- include('icon', { name: link.icon, cls: 'h-[1.1rem] w-[1.1rem] ' + (active ? '' : 'text-gray-500') }) %><%= link.label %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </nav>
  <div class="hidden items-center gap-3 border-t border-gray-200 px-4 py-4 md:flex">
    <%- include('avatar', { person: currentUser, cls: 'h-10 w-10 shrink-0' }) %>
    <div class="min-w-0 flex-1">
      <p class="truncate text-[0.95rem] font-semibold"><%= currentUser.fullName %></p>
      <p class="text-[0.8rem] text-gray-500">Staff</p>
    </div>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="flex h-10 w-10 items-center justify-center rounded-md text-gray-700 hover:bg-surface hover:text-ink" aria-label="Log out" title="Log out"><%- include('icon', { name: 'log-out', cls: 'h-[1.1rem] w-[1.1rem]' }) %></button>
    </form>
  </div>
</aside>
