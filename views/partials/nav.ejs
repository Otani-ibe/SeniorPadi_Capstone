<%# staff sidebar (left on computers, a scrolling bar on phones) %>
<%
  const links = [
    { href: '/admin', label: 'Dashboard', icon: 'fa-chart-pie' },
    { href: '/admin/events', label: 'Events', icon: 'fa-calendar-days' },
    { href: '/admin/organizations', label: 'Organizations', icon: 'fa-building' },
    { href: '/admin/seniors', label: 'Seniors', icon: 'fa-users' },
    { href: '/admin/ids', label: 'ID checks', icon: 'fa-id-card' },
    { href: '/admin/reports', label: 'Reports', icon: 'fa-flag' },
    { href: '/admin/onboarding-video', label: 'Welcome video', icon: 'fa-circle-play' },
    { href: '/admin/staff', label: 'Staff', icon: 'fa-user-shield' },
    { href: '/admin/system', label: 'System', icon: 'fa-gear' }
  ];
%>
<aside class="bg-indigo text-white md:sticky md:top-0 md:flex md:h-screen md:w-64 md:shrink-0 md:flex-col">
  <div class="flex items-center justify-between gap-3 px-5 py-4 md:py-6">
    <a href="/admin" class="flex items-center gap-2 text-[1.25rem] font-semibold text-white no-underline">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/15"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>
      SeniorPadi
    </a>
    <span class="flex items-center gap-2">
      <span class="rounded-full bg-coral px-2.5 py-0.5 text-[0.75rem] font-semibold">Staff</span>
      <form action="/logout" method="post" class="md:hidden">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="rounded-full px-2 py-1 text-white/85" aria-label="Log out"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></button>
      </form>
    </span>
  </div>
  <nav aria-label="Admin" class="overflow-x-auto px-3 pb-3 md:flex-1 md:overflow-y-auto">
    <ul class="flex gap-1 md:flex-col">
      <% links.forEach(function (link) {
           const active = currentPath === link.href || (link.href !== '/admin' && currentPath.startsWith(link.href));
      %>
        <li>
          <a href="<%= link.href %>" <%= active ? 'aria-current=page' : '' %>
             class="flex items-center gap-3 whitespace-nowrap rounded-xl px-3 py-2.5 text-[0.95rem] no-underline transition
                    <%= active ? 'bg-white font-semibold text-indigo' : 'font-medium text-white/85 hover:bg-white/10 hover:text-white' %>">
            <i class="fa-solid <%= link.icon %> w-5 text-center" aria-hidden="true"></i><%= link.label %>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
  <div class="hidden border-t border-white/10 px-5 py-4 md:block">
    <p class="text-[0.85rem] text-white/70">Logged in as</p>
    <p class="mb-3 font-medium"><%= currentUser.fullName %></p>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-white/85 hover:text-white"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Log out</button>
    </form>
  </div>
</aside>
