<%# online/offline badge beside a name. Words as well as the dot, never colour alone. Hidden when they chose not to show status.
    public/js/presence.js keeps it current. needs: person %>
<% const st = presenceOf(person); %>
<span class="presence <%= typeof corner !== 'undefined' && corner ? 'presence-corner' : '' %>" data-presence="<%= person.id %>" data-status="<%= st || '' %>" <%= st ? '' : 'hidden' %>
      data-online="<%= t('presence.online') %>" data-offline="<%= t('presence.offline') %>">
  <span class="presence-dot" aria-hidden="true"></span><span data-presence-text <%- typeof corner !== 'undefined' && corner ? 'class="sr-only"' : '' %>><%= st === 'online' ? t('presence.online') : t('presence.offline') %></span>
</span>
