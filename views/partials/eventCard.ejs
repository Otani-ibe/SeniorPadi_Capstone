<%# one event: name, picture, all the details, then Register and Skip.
    On a phone the name sits above the picture; on a wide screen the picture is on the left.
    In the Find events deck it needs: event, pos (0 = on top, 1 and 2 = peeking behind, 3 = hidden), number, total, filters.
    Without pos (e.g. the "you're registered" pop-up) it's a plain card with no counter or buttons. %>
<% const inDeck = typeof pos !== 'undefined'; %>
<article class="<%= inDeck ? 'deck-card' : '' %> flex flex-col overflow-hidden rounded-card bg-white shadow-xl shadow-ink/10 ring-1 ring-gray-200 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:grid-rows-[auto_1fr] lg:grid-cols-[minmax(0,32rem)_minmax(0,1fr)]"
  <% if (inDeck) { %>
         data-deck-card data-pos="<%= pos %>" data-number="<%= number %>"
         tabindex="<%= pos === 0 ? 0 : -1 %>" <%= pos === 0 ? '' : 'inert' %>
         aria-label="<%= t('stack.counter', { n: number, total: total }) %>: <%= event.tTitle || event.title %>"
  <% } %>>

  <%# name and host %>
  <div class="px-6 pb-4 pt-6 text-center md:col-start-2 md:row-start-1 md:px-8 md:pb-0 md:pt-8 md:text-left">
    <% if (inDeck) { %><p class="mb-2 text-[0.95rem] font-medium text-gray-700"><%= t('stack.counter', { n: number, total: total }) %></p><% } %>
    <h2 class="text-[1.75rem] leading-tight md:line-clamp-2 md:text-[1.85rem]"><%= event.tTitle || event.title %></h2>
    <% if (event.Organization) { %>
      <p class="mt-2 text-gray-700"><%= t('stack.hosted_by', { org: event.Organization.name }) %></p>
    <% } %>
  </div>

  <%# the picture: nothing is drawn over it, so the whole flyer can be read %>
  <div class="relative px-3 md:col-start-1 md:row-span-2 md:row-start-1 md:m-3 md:mr-0 md:aspect-square md:self-start md:overflow-hidden md:rounded-card md:bg-mist md:px-0">
    <%# a blurred copy of the flyer fills any space round it, so a shorter flyer never leaves an empty box %>
    <% if (event.imageUrl) { %><img src="<%= event.imageUrl %>" alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 hidden h-full w-full scale-125 object-cover opacity-70 blur-2xl md:block"><% } %>
    <div class="relative w-full md:absolute md:inset-0">
      <%- include('eventImage', { event, natural: true, imgClass: 'block w-full rounded-card select-none md:h-full md:object-contain' }) %>
    </div>

    <% if (inDeck) { %>
      <%# big stamps that appear as the card is thrown away %>
      <span class="deck-stamp deck-stamp-skip" data-stamp="skip" aria-hidden="true"><%= t('stack.skip') %></span>
      <span class="deck-stamp deck-stamp-yes" data-stamp="register" aria-hidden="true"><%= t('stack.register') %></span>
    <% } %>
  </div>

  <div class="flex flex-1 flex-col p-6 md:col-start-2 md:row-start-2 md:px-8 md:pb-6 md:pt-0">
    <ul class="space-y-2.5 md:mt-3">
      <li class="flex items-start gap-3">
        <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="icon-calendar" aria-hidden="true"></i></span>
        <span><span class="font-semibold"><%= formatDate(event.startsAt) %></span><br><%= formatTime(event.startsAt) %> – <%= formatTime(event.endsAt) %></span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="icon-map-pin" aria-hidden="true"></i></span>
        <span class="min-w-0">
          <span class="font-semibold"><%= event.area ? t('area.' + event.area) : t('events.area_unconfirmed') %></span><br>
          <span class="line-clamp-2"><%= event.locationText %></span>
          <% if (event.locationMapsUrl) { %><br><a href="<%= event.locationMapsUrl %>" rel="noopener" target="_blank" class="inline-flex min-h-12 items-center" aria-label="<%= forEvent(t('event.open_map'), event) %>"><%= t('event.open_map') %></a><% } %>
        </span>
      </li>
    </ul>

    <%# price and slots left, side by side %>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="inline-flex w-fit items-center gap-2 rounded-md bg-mist px-3.5 py-1.5 text-[0.95rem] font-semibold text-indigo"><i class="<%= event.priceLabel() ? 'icon-tag' : 'icon-gift' %>" aria-hidden="true"></i><%= event.priceLabel() || t('events.free') %></span>
      <%- include('slotsLeft', { id: event.id, slotsLeft: typeof event.slotsLeft === 'undefined' ? null : event.slotsLeft }) %>
    </div>

    <%# the whole description on phones; beside the picture on wider screens, up to 4 lines %>
    <p class="mt-3 whitespace-pre-line text-gray-700 md:line-clamp-4"><%= event.tDescription || event.description %></p>

    <%# Skip and Register. They work without JavaScript too. %>
    <% if (inDeck) { %>
    <div class="mt-auto grid grid-cols-1 gap-4 pt-4 sm:grid-cols-2">
      <% if (currentUser) { %>
        <form action="/events/<%= event.id %>/register" method="post" data-deck-register>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn w-full sm:w-full">
            <i class="icon-check" aria-hidden="true"></i><%= t('stack.register') %>
          </button>
        </form>
      <% } else if (bookingFor) { %>
        <%# booking for a parent: Register books them %>
        <%- include('bookButton', { event, cls: 'min-h-14 text-[1.1rem]' }) %>
      <% } else { %>
        <%# not logged in: the sign-up pop-up opens for this event %>
        <a href="<%= eventsUrl({ category, area, q }) %>&login=<%= event.id %>#login" data-deck-register data-event-id="<%= event.id %>" aria-label="<%= forEvent(t('stack.register'), event) %>"
           class="btn w-full sm:w-full">
          <i class="icon-check" aria-hidden="true"></i><%= t('stack.register') %>
        </a>
      <% } %>
      <form action="/events/<%= event.id %>/skip" method="post" data-deck-skip>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="category" value="<%= category %>">
        <input type="hidden" name="area" value="<%= area || 'all' %>">
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <% if (showSkipped) { %><input type="hidden" name="skipped" value="1"><% } %>
        <button aria-label="<%= forEvent(t('stack.skip'), event) %>" class="btn-plain w-full sm:w-full">
          <i class="icon-x" aria-hidden="true"></i><%= t('stack.skip') %>
        </button>
      </form>
    </div>
    <%- include('bookLink', { event }) %>
    <% } %>
  </div>
</article>
