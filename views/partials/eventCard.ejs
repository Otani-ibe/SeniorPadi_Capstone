<%# one event as a card: rounded picture, name, a few words, outlined tags, Register (and Skip). Picture on top on phones, left on wide screens.
    picture keeps its own shape so any flyer fits (landscape, square, portrait).
    deck needs: event, pos (0 top, 1 and 2 peeking, 3 hidden), number, total, filters.
    without pos (e.g. the registered pop-up) it is a plain card, no counter or buttons.
    in the deck a signed-in senior's first cards can carry a note (event.deckNotes: 'near', 'recommended') %>
<% const inDeck = typeof pos !== 'undefined';
   const notes = Array.isArray(event.deckNotes) ? event.deckNotes : [];
   const alt = event.tImageAlt || event.imageAlt || t('event.image_alt', { title: event.tTitle || event.title }); %>
<article class="<%= inDeck ? 'deck-card' : '' %> flex flex-col gap-3 rounded-[1.75rem] bg-white p-2.5 shadow-md shadow-slate-900/5 ring-1 ring-slate-100 md:flex-row md:gap-5 md:p-3"
  <% if (inDeck) { %>
         data-deck-card data-pos="<%= pos %>" data-number="<%= number %>"
         tabindex="<%= pos === 0 ? 0 : -1 %>" <%= pos === 0 ? '' : 'inert' %>
         aria-label="<%= t('stack.counter', { n: number, total: total }) %>: <%= event.tTitle || event.title %>"
  <% } %>>

  <%# picture at its own shape, card fits the flyer, nothing cut or padded (a very tall picture stops at a set height, still whole) %>
  <div class="relative md:max-w-[52%] md:shrink-0 md:self-start">
    <% if (event.imageUrl) { %>
      <img src="<%= event.imageUrl %>" alt="<%= alt %>" loading="lazy" draggable="false" class="mx-auto block h-auto w-auto max-w-full select-none rounded-[1.25rem] max-h-[24rem] md:max-h-[27rem]">
    <% } else { %>
      <span class="flex aspect-[4/3] w-full items-center justify-center rounded-[1.25rem] bg-mist text-[3rem] text-indigo md:w-[22rem]" aria-hidden="true"><i class="<%= categoryIcons[event.category] || 'icon-image' %>"></i></span>
    <% } %>

    <% if (inDeck) { %>
      <%# big stamps that appear as the card is thrown away %>
      <span class="deck-stamp deck-stamp-skip" data-stamp="skip" aria-hidden="true"><%= t('stack.skip') %></span>
      <span class="deck-stamp deck-stamp-yes" data-stamp="register" aria-hidden="true"><%= t('stack.register') %></span>
    <% } %>
  </div>

  <%# wide screens: words and Register / Skip share the right column. phones: this wrapper disappears, buttons belong to the whole card %>
  <div class="contents md:flex md:min-w-0 md:flex-1 md:flex-col">
  <div class="flex min-w-0 flex-col px-1.5 pb-1.5 md:py-1.5 md:pr-1.5">
    <% if (inDeck) { %><p class="mb-1 text-[0.95rem] font-medium text-slate-500"><%= t('stack.counter', { n: number, total: total }) %></p><% } %>
    <%# why this one is first: close to them, and/or picked for them %>
    <% if (notes.length > 0) { %>
      <p class="mb-1.5 flex flex-wrap gap-1.5">
        <% notes.forEach(function (note) { %>
          <span data-deck-note="<%= note %>" class="inline-flex items-center gap-1.5 rounded-full bg-mist px-3 py-1 text-[0.9rem] font-semibold text-indigo"><i class="<%= note === 'near' ? 'icon-navigation' : 'icon-sparkles' %>" aria-hidden="true"></i><%= t(note === 'near' ? 'deck.near' : 'deck.recommended') %></span>
        <% }) %>
      </p>
    <% } %>
    <h2 class="text-[1.45rem] font-extrabold leading-tight tracking-tight text-slate-900 md:line-clamp-2 md:text-[1.6rem]"><%= event.tTitle || event.title %></h2>
    <% if (event.Organization) { %>
      <p class="mt-1 text-slate-600"><%= t('stack.hosted_by', { org: event.Organization.name }) %></p>
    <% } %>

    <%# a few words about it %>
    <p class="mt-1.5 whitespace-pre-line leading-snug text-slate-700 line-clamp-2"><%= event.tDescription || event.description %></p>

    <%# tags: kind of event, price, and how many places are left %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <% if (event.category) { %><span class="tag-outline"><i class="<%= categoryIcons[event.category] || 'icon-tag' %>" aria-hidden="true"></i><%= t('category.' + event.category) %></span><% } %>
      <span class="tag-outline"><i class="<%= event.priceLabel() ? 'icon-tag' : 'icon-gift' %>" aria-hidden="true"></i><%= event.priceLabel() || t('events.free') %></span>
      <%- include('slotsLeft', { id: event.id, slotsLeft: typeof event.slotsLeft === 'undefined' ? null : event.slotsLeft }) %>
    </div>

    <%# when and where %>
    <ul class="mt-3 space-y-1.5">
      <li class="flex items-start gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mist text-[1rem] text-indigo"><i class="icon-calendar" aria-hidden="true"></i></span>
        <span class="leading-snug"><span class="font-semibold"><%= formatDate(event.startsAt) %></span><br><span class="text-slate-600"><%= formatTime(event.startsAt) %> – <%= formatTime(event.endsAt) %></span></span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mist text-[1rem] text-indigo"><i class="icon-map-pin" aria-hidden="true"></i></span>
        <span class="min-w-0 leading-snug">
          <span class="font-semibold"><%= event.area ? t('area.' + event.area) : t('events.area_unconfirmed') %></span><br>
          <span class="line-clamp-2 text-slate-600"><%= event.locationText %></span>
          <% if (event.locationMapsUrl) { %><a href="<%= event.locationMapsUrl %>" rel="noopener" target="_blank" class="inline-flex min-h-12 items-center font-semibold text-indigo" aria-label="<%= forEvent(t('event.open_map'), event) %>"><%= t('event.open_map') %></a><% } %>
        </span>
      </li>
    </ul>

    <% if (inDeck) { %><%- include('bookLink', { event }) %><% } %>
  </div>

  <%# Register and Skip. They work without JavaScript too. %>
  <% if (inDeck) { %>
    <div class="grid grid-cols-2 gap-2 px-1.5 pb-1.5 pt-1 md:mt-auto md:pt-4">
      <% if (currentUser) { %>
        <form action="/events/<%= event.id %>/register" method="post" data-deck-register>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button aria-label="<%= forEvent(t('stack.register'), event) %>" class="btn min-h-12 w-full px-3 text-[1.05rem] sm:w-full">
            <i class="icon-check" aria-hidden="true"></i><%= t('stack.register') %>
          </button>
        </form>
      <% } else if (bookingFor) { %>
        <%# booking for a parent: Register books them %>
        <%- include('bookButton', { event, cls: 'min-h-12 text-[1.05rem]' }) %>
      <% } else { %>
        <%# not logged in: the sign-up pop-up opens for this event %>
        <a href="<%= eventsUrl({ category, area, q }) %>&login=<%= event.id %>#login" data-deck-register data-event-id="<%= event.id %>" aria-label="<%= forEvent(t('stack.register'), event) %>"
           class="btn min-h-12 w-full px-3 text-[1.05rem] sm:w-full">
          <i class="icon-check" aria-hidden="true"></i><%= t('stack.register') %>
        </a>
      <% } %>
      <form action="/events/<%= event.id %>/skip" method="post" data-deck-skip>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="category" value="<%= category %>">
        <input type="hidden" name="area" value="<%= area || 'all' %>">
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <% if (showSkipped) { %><input type="hidden" name="skipped" value="1"><% } %>
        <button aria-label="<%= forEvent(t('stack.skip'), event) %>" class="btn-plain min-h-12 w-full px-3 sm:w-full">
          <i class="icon-x" aria-hidden="true"></i><%= t('stack.skip') %>
        </button>
      </form>
    </div>
  <% } %>
  </div>
</article>
