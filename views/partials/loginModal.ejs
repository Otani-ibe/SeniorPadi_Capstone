<%#
  Sign-up / log-in pop-up. Shown when someone who isn't logged in (or whose session ended)
  taps Register or opens Find seniors. Works without JavaScript.
  needs: heading, mode ('signup' or 'login'), switchHref (same page, other mode),
         registerEventId (optional), next (optional), closeHref
%>
<% const regId = typeof registerEventId !== 'undefined' && registerEventId ? registerEventId : ''; %>
<% const goNext = typeof next !== 'undefined' && next ? next : ''; %>
<% const isSignup = typeof mode !== 'undefined' && mode === 'signup'; %>
<div class="fixed inset-0 z-40 bg-ink/60" aria-hidden="true"></div>
<div id="login" role="dialog" aria-modal="true" aria-labelledby="login-title"
     class="fixed inset-x-0 bottom-0 z-50 max-h-[92vh] overflow-y-auto rounded-t-2xl bg-white p-6
            md:inset-x-auto md:bottom-auto md:left-1/2 md:top-1/2 md:w-full md:max-w-lg md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-2xl md:p-8">
  <div class="mb-2 flex items-start justify-between gap-4">
    <h2 id="login-title" class="text-[1.6rem]"><%= isSignup ? t('modal.title_signup') : heading %></h2>
    <a href="<%= closeHref %>" data-modal-close class="rounded-lg px-2 text-3xl leading-none text-ink no-underline" aria-label="<%= t('modal.close') %>">&times;</a>
  </div>

  <% if (isSignup) { %>
    <p class="mb-5 text-gray-700"><%= t('modal.signup_note') %> <%= t('signup.code_note') %></p>
    <form action="/signup" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= regId %>">
      <input type="hidden" name="next" value="<%= goNext %>">
      <div class="field">
        <label for="modal-name"><%= t('signup.name') %></label>
        <input type="text" id="modal-name" name="fullName" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="modal-phone"><%= t('signup.phone') %></label>
        <%- include('phoneInput', { id: 'modal-phone', name: 'phone', value: '' }) %>
      </div>
      <label class="field flex items-start gap-3 font-normal">
        <input type="checkbox" name="ageDeclared" value="yes" class="mt-1 h-7 w-7 shrink-0">
        <strong><%= t('signup.age') %></strong>
      </label>
      <button class="btn w-full sm:w-full"><%= regId ? t('modal.signup_and_register') : t('signup.submit') %></button>
    </form>
    <p class="mt-5"><%= t('modal.have_account') %> <a href="<%= switchHref %>" data-modal-switch><%= t('home.login') %></a></p>

  <% } else { %>
    <p class="mb-5 text-gray-700"><%= t('modal.session_note') %></p>
    <form action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= regId %>">
      <input type="hidden" name="next" value="<%= goNext %>">
      <div class="field">
        <label for="modal-phone"><%= t('signup.phone') %></label>
        <%- include('phoneInput', { id: 'modal-phone', name: 'phone', value: '' }) %>
      </div>
      <button class="btn w-full sm:w-full"><%= t('login.send_code') %></button>
    </form>
    <p class="mt-5"><%= t('login.no_account') %> <a href="<%= switchHref %>" data-modal-switch><%= t('home.create_account') %></a></p>
  <% } %>
</div>
