<%# "Help on SeniorPadi": a full-width strip fixed to the bottom of the hero, for visitors. Ways to get help
    slide past slowly, without end; every item is a link. It stops while a finger, the mouse or the keyboard
    is on it, and stands still for people who turn animations off (then it scrolls sideways by hand).
    The second copy is only there so the loop has no gap; screen readers and the Tab key skip it. %>
<% if (!currentUser && !bookingFor) {
     const waBase = whatsappUrl ? whatsappUrl.split('?')[0] : '';
     const items = [
       { href: '/signup/parent', photo: 'senior-4', title: 'help.t1_title', tag: 'help.t1_tag' },
       { href: '/signup/parent', photo: 'senior-7', title: 'help.t2_title', tag: 'help.t2_tag' },
       { href: supportTel ? 'tel:' + supportTel : '/call', photo: 'senior-3', title: 'help.t3_title', tag: 'help.t3_tag' },
       supportTel ? { href: waBase + '?text=' + encodeURIComponent(t('whatsapp.msg_2')), external: true, photo: 'senior-8', title: 'help.t4_title', tag: 'help.t4_tag' } : null,
       { href: '/signup/parent', photo: 'senior-1', title: 'help.t5_title', tag: 'help.t5_tag' }
     ].filter(Boolean); %>
  <section class="ticker flex items-stretch bg-indigo-deep text-white" aria-label="<%= t('help.ticker_label') %>" data-ticker>
    <p class="flex w-32 shrink-0 items-center border-r border-white/10 px-4 text-[1rem] font-semibold leading-snug text-white/90 sm:w-auto sm:px-8 sm:text-[0.9rem] md:pl-[max(2.5rem,calc((100vw-72rem)/2+2.5rem))]">
      <%= t('help.ticker_label') %>
    </p>
    <div class="ticker-viewport min-w-0 flex-1">
      <div class="ticker-track">
        <% [0, 1].forEach(function (copy) { %>
          <ul class="flex shrink-0 items-center gap-12 py-4 pr-12 pl-6 sm:gap-16 sm:py-5 sm:pr-16 sm:pl-10" <%- copy ? 'aria-hidden="true"' : '' %>>
            <% items.forEach(function (item) { %>
              <li class="shrink-0">
                <a href="<%= item.href %>" <%- item.external ? 'target="_blank" rel="noopener"' : '' %> <%- copy ? 'tabindex="-1"' : '' %>
                   class="group flex items-center gap-3.5 text-white no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
                  <img src="/images/home/<%= item.photo %>.jpg" alt="" class="h-10 w-10 shrink-0 rounded-full object-cover sm:h-11 sm:w-11" width="44" height="44">
                  <span class="whitespace-nowrap text-[1.2rem] font-semibold group-hover:underline sm:text-[1.35rem]"><%= t(item.title) %></span>
                  <span class="whitespace-nowrap text-[1rem] text-white/80 group-hover:text-white"><%= t(item.tag) %></span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>
