<% const isAdminFooter = currentUser && currentUser.role === 'admin'; %>
  </main>
<% if (isAdminFooter) { %>
  </div>
<% } else { %>
  <footer class="mt-12 border-t border-gray-100 bg-surface">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <p class="logo mb-2 flex items-center gap-2 text-[1.2rem] font-bold tracking-tight">
          <%- include('logoMark', { size: 'h-8 w-8', uid: 'f' }) %><span>SeniorPadi</span>
        </p>
        <p class="text-gray-700"><%= t('footer.about') %></p>
      </div>
      <ul class="grid grid-cols-2 gap-x-8 gap-y-3">
        <li><a href="/about" class="font-medium text-indigo"><%= t('about.title') %></a></li>
        <li><a href="/events" class="font-medium text-indigo"><%= t('nav.find_events') %></a></li>
        <li><a href="/find-seniors" class="font-medium text-indigo"><%= t('nav.find_seniors') %></a></li>
        <li><a href="<%= supportTel ? 'tel:' + supportTel : '/call' %>" class="font-medium text-indigo"><%= t('call.title') %></a></li>
        <% if (supportTel) { %><li class="col-span-2"><a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="font-medium text-indigo"><%= t('whatsapp.text_us') %></a></li><% } %>
      </ul>
    </div>
  </footer>
<% } %>
  <%- include('helpNudge') %>
  <script src="/js/swipe.js" defer></script>
  <% if (!currentUser && !bookingFor) { %><script src="/js/help.js" defer></script><% } %>
</body>
</html>
