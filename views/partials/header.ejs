<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SeniorPadi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
    <script src="/js/phone-input.js" defer></script>
</head>
<body class="flex min-h-screen flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:p-3"><%= t('nav.skip') %></a>

  <header class="bg-indigo text-white">
    <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-3 px-4 py-3">
      <a href="/" class="text-2xl font-bold text-white no-underline">SeniorPadi</a>

      <form action="/language" method="post" class="flex gap-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= currentPath %>">
        <button name="lang" value="en" class="rounded-md px-3 py-1 text-base font-bold <%= lang === 'en' ? 'bg-white text-indigo' : 'text-white underline' %>">English</button>
        <button name="lang" value="yo" class="rounded-md px-3 py-1 text-base font-bold <%= lang === 'yo' ? 'bg-white text-indigo' : 'text-white underline' %>">Yorùbá</button>
      </form>
    </div>

    <% if (currentUser) { %>
      <%- include('nav') %>
    <% } %>
  </header>

  <main id="main" class="page flex-1">
    <%- include('flash') %>
