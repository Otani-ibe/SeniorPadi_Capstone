<%
  // seniors and visitors get the simple menu; staff get the admin sidebar
  const isAdmin = currentUser && currentUser.role === 'admin';
  const otherLang = lang === 'en' ? 'yo' : 'en';
  const isWide = typeof wide !== 'undefined' && wide;
  const isFull = typeof fullWidth !== 'undefined' && fullWidth; // landing page: sections go edge to edge
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SeniorPadi</title>
  <link rel="icon" href="/images/logo-mark.svg" type="image/svg+xml">
  <link rel="icon" href="/images/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#6d28d9">
  <%# what shows when the link is shared on WhatsApp or Facebook %>
  <meta name="description" content="<%= t('home.share_description') %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="SeniorPadi">
  <meta property="og:title" content="<%= title %> | SeniorPadi">
  <meta property="og:description" content="<%= t('home.share_description') %>">
  <meta property="og:image" content="<%= appUrl %>/images/og-share.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <script>
    document.documentElement.classList.add('js');
    // the logo plays its little hello once per visit, not on every page
    try { if (!sessionStorage.getItem('spLogo')) { document.documentElement.classList.add('logo-intro'); sessionStorage.setItem('spLogo', '1'); } } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/phone-input.js" defer></script>
  <script src="/js/show-password.js" defer></script>
  <script src="/js/reveal.js" defer></script>
</head>

<% if (isAdmin) { %>
<body class="min-h-screen bg-surface md:flex">
  <a href="#main" class="sr-only focus:not-sr-only focus:p-3">Skip to main content</a>
  <%- include('nav') %>
  <div class="flex min-h-screen min-w-0 flex-1 flex-col">
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:px-10 md:py-10">
      <%- include('flash') %>
<% } else { %>
<body class="flex min-h-screen flex-col pb-20 xl:pb-0">
  <a href="#main" class="sr-only focus:not-sr-only focus:p-3"><%= t('nav.skip') %></a>

  <header class="sticky top-0 z-30 border-b border-gray-100 bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
      <%# on very narrow phones only the round logo shows, so everything fits on one line %>
      <a href="/" aria-label="SeniorPadi" class="logo flex min-w-0 shrink-0 items-center gap-2.5 text-[1.25rem] font-bold tracking-tight text-ink no-underline sm:text-[1.35rem]">
        <%- include('logoMark', { size: 'h-10 w-10', uid: 'h' }) %>
        <span class="logo-word <%= currentUser ? 'max-[429px]:sr-only' : 'max-[359px]:sr-only' %>">SeniorPadi</span>
      </a>

      <%# the page links fit in the top bar only on wide screens; phones, tablets and small laptops use the bar at the bottom %>
      <div class="hidden xl:block"><%- include('seniorNav', { placement: 'top' }) %></div>

      <div class="flex shrink-0 items-center gap-2">
        <%# one button that always shows the OTHER language %>
        <form action="/language" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= currentPath %>">
          <button name="lang" value="<%= otherLang %>" lang="<%= otherLang %>"
                  class="inline-flex min-h-11 items-center gap-2 rounded-md bg-surface px-3 text-[0.95rem] font-medium text-ink hover:bg-mist sm:px-4">
            <i class="fa-solid fa-language text-indigo" aria-hidden="true"></i>
            <%= otherLang === 'yo' ? 'Yorùbá' : 'English' %>
          </button>
        </form>
        <% if (currentUser) { %>
          <a href="/account" aria-label="<%= t('nav.account') %>" class="block shrink-0 rounded-full ring-2 ring-mist no-underline transition hover:ring-indigo">
            <%- include('avatar', { person: currentUser, cls: 'h-11 w-11' }) %>
          </a>
        <% } else { %>
          <a href="/login" class="hidden min-h-11 items-center rounded-md bg-indigo px-5 text-[0.95rem] font-semibold text-white no-underline hover:bg-indigo-dark sm:inline-flex"><%= t('home.login') %></a>
        <% } %>
      </div>
    </div>
  </header>

  <%# on phones the same menu sits at the bottom of the screen %>
  <div class="xl:hidden"><%- include('seniorNav', { placement: 'bottom' }) %></div>

  <main id="main" class="<%= isFull ? 'w-full' : (isWide ? 'page-wide' : 'page') %> flex-1">
    <% if (isFull) { %><div class="mx-auto max-w-6xl px-4 pt-4 [&:not(:has(*))]:hidden"><%- include('flash') %></div><% } else { %><%- include('flash') %><% } %>
<% } %>
