<%# optional check-in code, tucked away so it never looks required %>
<details class="mx-auto mt-5 max-w-sm text-left">
  <summary class="flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full bg-white px-5 font-semibold text-indigo">
    <i class="fa-solid fa-qrcode" aria-hidden="true"></i><%= t('qr.show') %>
  </summary>
  <div class="mt-3 rounded-[1.25rem] bg-white p-4 text-center">
    <div class="mx-auto w-48 max-w-full" aria-hidden="true"><%- qr %></div>
    <p class="mt-2 text-gray-700"><%= t('qr.explain') %></p>
  </div>
</details>
