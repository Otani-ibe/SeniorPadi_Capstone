<%# optional check-in code, tucked away so it never looks required %>
<details class="mx-auto mt-5 max-w-sm text-left">
  <summary class="btn-plain w-full cursor-pointer sm:w-full">
    <i class="icon-qr-code" aria-hidden="true"></i><%= t('qr.show') %>
  </summary>
  <div class="mt-3 rounded-card bg-white p-4 text-center">
    <div class="mx-auto w-48 max-w-full" aria-hidden="true"><%- qr %></div>
    <p class="mt-2 text-gray-700"><%= t('qr.explain') %></p>
  </div>
</details>
