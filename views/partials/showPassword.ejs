<%# "Show password" tick box, toggles every password box in the form. Hidden until the script turns it on (needs JavaScript). needs: id %>
<label for="<%= id %>" class="field flex items-center gap-3 font-medium" data-show-password hidden>
  <input type="checkbox" id="<%= id %>" class="h-6 w-6 shrink-0 accent-indigo">
  <%= t('signup.show_password') %>
</label>
