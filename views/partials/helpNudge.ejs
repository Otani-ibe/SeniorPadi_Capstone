<%# "Having trouble registering for an event?": opens once a visitor has been on the site for NUDGE_SECONDS
    (counted across pages) without signing up, waiting while they type. At most once per visit.
    Offers family help, a call, or WhatsApp.
    Not shown to signed-in people, to a child already booking for a parent, on the log-in pages, or on the
    family pages themselves. Add ?help=now to any address to see it after 2 seconds (for demos).
    Script: public/js/help.js %>
<% const NUDGE_SECONDS = 90;
   if (!currentUser && !bookingFor && !/^\/(signup\/parent|book-for-parent|login|admin)/.test(currentPath)) {
     const waBase = whatsappUrl ? whatsappUrl.split('?')[0] : '';
     const options = [
       { href: '/signup/parent', title: t('help.family_title'), text: t('help.family_text'), action: t('help.family_action'), main: true },
       { href: supportTel ? 'tel:' + supportTel : '/call', title: t('call.title'), text: t('help.call_text'), action: t('help.call_action') },
       supportTel ? { href: waBase + '?text=' + encodeURIComponent(t('whatsapp.msg_2')), external: true, title: t('whatsapp.text_us'), text: t('help.wa_text'), action: t('help.wa_action') } : null
     ].filter(Boolean); %>
  <div data-help-nudge data-wait="<%= NUDGE_SECONDS %>" hidden>
    <div class="fixed inset-0 z-40 bg-ink/60" data-help-close aria-hidden="true"></div>
    <%# a small box in the middle of the screen, on phones too %>
    <div role="dialog" aria-modal="true" aria-labelledby="help-title" tabindex="-1" style="outline: none"
         class="help-sheet fixed left-1/2 top-1/2 z-50 max-h-[90vh] w-[calc(100%-3rem)] max-w-sm -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-card bg-white p-4 shadow-2xl sm:max-w-md sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <h2 id="help-title" class="pt-2 text-[1.15rem] leading-tight sm:text-[1.5rem]"><%= t('help.nudge_title') %></h2>
        <button type="button" data-help-close class="-mr-2 -mt-1 inline-flex min-h-12 shrink-0 items-center gap-1.5 rounded-md px-3 font-semibold text-ink transition hover:bg-gray-100">
          <i class="icon-x text-[1.2rem]" aria-hidden="true"></i><%= t('modal.close') %>
        </button>
      </div>
      <p class="mt-1 text-[0.95rem] leading-snug text-gray-700"><%= t('help.nudge_text') %></p>

      <%# one bordered list, a line between each choice, the action on the right.
          The line under each choice is left out on phones to keep the box small. %>
      <ul class="mt-3 divide-y divide-gray-200 rounded-card border border-gray-200">
        <% options.forEach(function (o) { %>
          <li>
            <a href="<%= o.href %>" <%- o.external ? 'target="_blank" rel="noopener"' : '' %>
               class="group flex items-center justify-between gap-3 px-3 py-1.5 text-ink no-underline transition hover:bg-surface">
              <span class="min-w-0 flex-1 leading-snug">
                <span class="block text-[0.95rem] font-semibold sm:text-base"><%= o.title %></span>
                <span class="mt-0.5 hidden text-[0.95rem] text-gray-700 sm:block"><%= o.text %></span>
              </span>
              <span class="<%= o.main ? 'btn' : 'btn-plain' %> min-h-12 w-auto shrink-0 px-4 sm:w-auto"><%= o.action %></span>
            </a>
          </li>
        <% }) %>
      </ul>

      <button type="button" data-help-close class="mt-3 hidden min-h-12 w-full items-center justify-center rounded-md font-semibold text-gray-700 sm:inline-flex transition hover:bg-gray-100"><%= t('help.no_thanks') %></button>
    </div>
  </div>
<% } %>
