<%# "Having trouble registering for an event?": opens once a visitor has been on the site for NUDGE_SECONDS
    (counted across pages) without signing up, waiting while they type. At most once per visit.
    Offers family help, a call, or WhatsApp.
    Not shown to signed-in people, to a child already booking for a parent, on the log-in pages, or on the
    family pages themselves. Add ?help=now to any address to see it after 2 seconds (for demos).
    Script: public/js/help.js %>
<% const NUDGE_SECONDS = 90;
   if (!currentUser && !bookingFor && !/^\/(signup\/parent|book-for-parent|login|admin)/.test(currentPath)) {
     const waBase = whatsappUrl ? whatsappUrl.split('?')[0] : '';
     const options = [
       { href: '/signup/parent', title: t('help.family_title'), text: t('help.family_text'), action: t('help.family_action'), main: true },
       { href: supportTel ? 'tel:' + supportTel : '/call', title: t('call.title'), text: t('help.call_text'), action: t('help.call_action') },
       supportTel ? { href: waBase + '?text=' + encodeURIComponent(t('whatsapp.msg_2')), external: true, title: t('whatsapp.text_us'), text: t('help.wa_text'), action: t('help.wa_action') } : null
     ].filter(Boolean); %>
  <div data-help-nudge data-wait="<%= NUDGE_SECONDS %>" hidden>
    <div class="fixed inset-0 z-40 bg-ink/60" data-help-close aria-hidden="true"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="help-title" tabindex="-1" style="outline: none"
         class="help-sheet fixed inset-x-0 bottom-0 z-50 max-h-[94vh] overflow-y-auto rounded-t-card bg-white px-5 pt-6 pb-7 shadow-2xl sm:inset-x-auto sm:bottom-auto sm:left-1/2 sm:top-1/2 sm:w-[92%] sm:max-w-xl sm:-translate-x-1/2 sm:-translate-y-1/2 sm:rounded-card sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <p class="pt-2.5 text-[0.85rem] font-bold uppercase tracking-[0.1em] text-gray-500"><%= t('help.ticker_label') %></p>
        <button type="button" data-help-close class="-mr-2 inline-flex min-h-11 items-center gap-1.5 rounded-md px-3 font-semibold text-ink transition hover:bg-gray-100">
          <i class="fa-solid fa-xmark text-[1.2rem]" aria-hidden="true"></i><%= t('modal.close') %>
        </button>
      </div>

      <h2 id="help-title" class="mt-2 text-[1.7rem] leading-tight sm:text-[2rem]"><%= t('help.nudge_title') %></h2>
      <p class="mt-2 text-[1.1rem] text-gray-700"><%= t('help.nudge_text') %></p>

      <%# one bordered list, a line between each choice, the action on the right %>
      <ul class="mt-6 divide-y divide-gray-200 rounded-card border border-gray-200">
        <% options.forEach(function (o) { %>
          <li>
            <a href="<%= o.href %>" <%- o.external ? 'target="_blank" rel="noopener"' : '' %>
               class="group flex flex-wrap items-center justify-between gap-x-4 gap-y-3 p-4 text-ink no-underline transition hover:bg-surface sm:flex-nowrap">
              <span class="min-w-0 flex-1 basis-56 leading-snug">
                <span class="block text-[1.15rem] font-semibold"><%= o.title %></span>
                <span class="mt-0.5 block text-[0.98rem] text-gray-700"><%= o.text %></span>
              </span>
              <span class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-md px-4 font-semibold transition <%= o.main ? 'bg-indigo text-white group-hover:bg-indigo-dark' : 'border border-gray-300 bg-white group-hover:border-ink' %>"><%= o.action %></span>
            </a>
          </li>
        <% }) %>
      </ul>

      <button type="button" data-help-close class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-md font-semibold text-gray-700 transition hover:bg-gray-100"><%= t('help.no_thanks') %></button>
    </div>
  </div>
<% } %>
