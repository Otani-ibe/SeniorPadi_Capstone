<%- include('partials/header') %>
<%
  const tel = (supportPhone || '').replace(/[^\d+]/g, '');
  const reasons = [
    ['fa-user-gear', t('call.reason_account')],
    ['fa-circle-question', t('call.reason_questions')],
    ['fa-calendar-plus', t('call.reason_events')],
    ['fa-handshake', t('call.reason_partner')]
  ];
%>

<%# ================= HOW TO REACH US ================= %>
<section class="grid items-center gap-8 overflow-hidden rounded-[2rem] bg-mist px-6 py-9 md:grid-cols-[1.3fr_1fr] md:px-12 md:py-12">
  <div>
    <p class="font-semibold text-indigo"><%= t('call.kicker') %></p>
    <h1 class="mt-1 text-[2.4rem] font-bold leading-[1.1] tracking-tight md:text-[3.4rem]"><%= t('call.title') %></h1>
    <p class="mt-4 text-[1.2rem] leading-relaxed text-gray-700"><%= t('call.lead') %></p>

    <% if (tel) { %>
      <a href="tel:<%= tel %>" class="mt-7 inline-flex min-h-16 w-full items-center justify-between gap-4 rounded-full bg-indigo py-2 pl-7 pr-2 text-[1.25rem] font-semibold text-white no-underline shadow-lg shadow-indigo/25 transition hover:bg-indigo-dark sm:w-auto">
        <%= t('call.call_now', { phone: supportPhone }) %>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-indigo"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
      </a>
      <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="mt-3 inline-flex min-h-14 w-full items-center gap-3 rounded-full border-2 border-leaf bg-white px-6 text-[1.15rem] font-semibold text-ink no-underline transition hover:bg-emerald-50 sm:w-auto">
        <i class="fa-brands fa-whatsapp text-[1.4rem] text-leaf" aria-hidden="true"></i><%= t('whatsapp.text_us') %>
      </a>
    <% } else { %>
      <p class="mt-7 rounded-2xl bg-white p-5 font-medium"><%= t('call.no_number') %></p>
    <% } %>

    <p class="mt-5 flex items-center gap-2.5 text-[1.05rem] text-ink">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-indigo"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
      <span><span class="font-semibold"><%= t('call.hours_label') %>:</span> <%= hours %></span>
    </p>
  </div>

  <img src="/images/senior-phone.svg" alt="" class="mx-auto w-full max-w-[16rem] md:max-w-[20rem]" width="320" height="320">
</section>

<%# ================= WHAT WE CAN HELP WITH ================= %>
<section class="mt-12">
  <h2 class="text-[1.8rem] md:text-[2.2rem]"><%= t('call.help_with') %></h2>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
    <% reasons.forEach(function (r) { %>
      <li class="flex items-center gap-4 rounded-[1.5rem] bg-surface p-5">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo text-[1.2rem] text-white"><i class="fa-solid <%= r[0] %>" aria-hidden="true"></i></span>
        <span class="text-[1.1rem] font-medium leading-snug"><%= r[1] %></span>
      </li>
    <% }) %>
  </ul>
</section>

<%# ================= NOT READY TO CALL? ================= %>
<section class="mt-10 flex flex-col items-start gap-4 rounded-[1.5rem] border-2 border-gray-100 p-6 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-[1.15rem] font-semibold"><%= t('call.meanwhile') %></p>
  <div class="flex flex-wrap gap-3">
    <a href="/events" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-indigo px-5 font-semibold text-white no-underline hover:bg-indigo-dark"><%= t('about.cta_explore') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    <a href="/about" class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-indigo/25 px-5 font-semibold text-indigo no-underline hover:border-indigo"><%= t('about.link') %></a>
  </div>
</section>

<%- include('partials/footer') %>
