<%- include('partials/header') %>
<%
  const tel = (supportPhone || '').replace(/[^\d+]/g, '');
  const reasons = [
    ['icon-user-cog', t('call.reason_account')],
    ['icon-circle-help', t('call.reason_questions')],
    ['icon-calendar-plus', t('call.reason_events')],
    ['icon-handshake', t('call.reason_partner')]
  ];
%>

<%# ================= HOW TO REACH US ================= %>
<section class="grid items-center gap-8 overflow-hidden rounded-card bg-mist px-6 py-9 md:grid-cols-[1.3fr_1fr] md:px-12 md:py-12">
  <div>
    <h1 class="text-[2.4rem] font-bold leading-[1.1] tracking-tight md:text-[3.4rem]"><%= t('call.title') %></h1>
    <p class="mt-4 text-[1.2rem] leading-relaxed text-gray-700"><%= t('call.lead') %></p>

    <% if (tel) { %>
      <a href="tel:<%= tel %>" class="btn mt-7">
        <i class="icon-phone" aria-hidden="true"></i><%= t('call.call_now', { phone: supportPhone }) %>
      </a>
      <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="btn-plain mt-3 whitespace-nowrap">
        <i class="icon-whatsapp text-[1.4rem] text-leaf" aria-hidden="true"></i><%= t('whatsapp.text_us') %>
      </a>
    <% } else { %>
      <p class="mt-7 rounded-2xl bg-white p-5 font-medium"><%= t('call.no_number') %></p>
    <% } %>

    <p class="mt-5 flex items-center gap-2.5 text-[1.05rem] text-ink">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-indigo"><i class="icon-clock" aria-hidden="true"></i></span>
      <span><span class="font-semibold"><%= t('call.hours_label') %>:</span> <%= hours %></span>
    </p>
  </div>

  <img src="/images/senior-phone.svg" alt="" class="mx-auto w-full max-w-[16rem] md:max-w-[20rem]" width="320" height="320">
</section>

<%# ================= WHAT WE CAN HELP WITH ================= %>
<section class="mt-12">
  <h2 class="text-[1.8rem] md:text-[2.2rem]"><%= t('call.help_with') %></h2>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
    <% reasons.forEach(function (r) { %>
      <li class="flex items-center gap-4 py-2">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo text-[1.2rem] text-white"><i class="<%= r[0] %>" aria-hidden="true"></i></span>
        <span class="text-[1.1rem] font-medium leading-snug"><%= r[1] %></span>
      </li>
    <% }) %>
  </ul>
</section>

<%# ================= NOT READY TO CALL? ================= %>
<section class="mt-16 flex flex-col items-start gap-4 border-t border-gray-200 pt-8 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-[1.15rem] font-semibold"><%= t('call.meanwhile') %></p>
  <div class="flex flex-wrap gap-3">
    <a href="/events" class="btn"><%= t('about.cta_explore') %><i class="icon-arrow-right" aria-hidden="true"></i></a>
    <a href="/about" class="btn-plain"><%= t('about.link') %></a>
  </div>
</section>

<%- include('partials/footer') %>
