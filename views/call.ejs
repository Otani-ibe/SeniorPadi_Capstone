<%- include('partials/header') %>
<%
  const tel = (supportPhone || '').replace(/[^\d+]/g, '');
  const reasons = [
    ['<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>', t('call.reason_account')],
    ['<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .5c0 2-2.5 2-2.5 4M12 17h.01"/>', t('call.reason_questions')],
    ['<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5"/>', t('call.reason_events')]
  ];
%>
<div class="mx-auto max-w-xl text-center">
  <div class="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-leaf text-white">
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
  </div>
  <h1 class="mb-6"><%= t('call.title') %></h1>

  <div class="panel mb-6 text-left">
    <p class="mb-3 text-xl font-bold"><%= t('call.help_with') %></p>
    <ul class="space-y-3">
      <% reasons.forEach(function (r) { %>
        <li class="flex gap-3">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-indigo"><%- r[0] %></svg>
          <span><%= r[1] %></span>
        </li>
      <% }) %>
    </ul>
  </div>

  <% if (tel) { %>
    <a href="tel:<%= tel %>" class="btn-volunteer w-full text-xl sm:w-full"><%= t('call.call_now', { phone: supportPhone }) %></a>
  <% } else { %>
    <p class="panel"><%= t('call.no_number') %></p>
  <% } %>
  <p class="mt-3 text-gray-700"><%= hours %></p>
</div>

<%- include('partials/footer') %>
