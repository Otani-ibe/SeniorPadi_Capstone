<%- include('../partials/header') %>
<%
  const u = currentUser;
  const links = [
    ['/settings', 'fa-sliders', t('account.settings_link'), t('account.settings_hint')],
    ['/notifications', 'fa-bell', unreadCount > 0 ? t('nav.notifications_count', { count: unreadCount }) : t('nav.notifications'), t('account.notifications_hint')],
    ['/registrations', 'fa-ticket', t('stack.my_tickets'), t('account.tickets_hint', { count: ticketCount })],
    ['/history', 'fa-clock-rotate-left', t('nav.history'), t('account.history_hint')],
    ['/verify', 'fa-shield-halved', t('account.verify_link'), u.contactVerified() ? t('account.verified_hint') : t('account.not_verified_hint')],
    ['/onboarding', 'fa-circle-play', t('onboarding.watch_again'), t('account.guide_hint')],
    ['/change-password', 'fa-key', t('change.title'), t('account.password_hint')]
  ];
%>

<h1 class="mb-6" data-reveal><%= t('account.title') %></h1>

<div class="grid gap-6 md:grid-cols-[1fr_1.6fr]">
  <%# who you are %>
  <section class="card self-start text-center" data-reveal="left">
    <% if (u.profilePictureUrl) { %>
      <img src="<%= u.profilePictureUrl %>" alt="" class="mx-auto mb-4 h-28 w-28 rounded-full object-cover ring-4 ring-mist" width="112" height="112">
    <% } else { %>
      <div class="mx-auto mb-4 flex h-28 w-28 items-center justify-center rounded-full bg-gradient-to-br from-lilac to-indigo text-4xl font-semibold text-white" aria-hidden="true"><%= u.fullName.charAt(0) %></div>
    <% } %>
    <h2 class="text-[1.4rem]"><%= u.fullName %></h2>
    <p class="text-gray-600"><%= u.localPhone() %></p>
    <% if (u.area) { %><p class="text-gray-600"><i class="fa-solid fa-location-dot mr-1" aria-hidden="true"></i><%= u.area %></p><% } %>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <span class="<%= u.phoneVerifiedAt ? 'tag-leaf' : 'tag-amber' %>"><i class="fa-solid <%= u.phoneVerifiedAt ? 'fa-circle-check' : 'fa-circle-exclamation' %>" aria-hidden="true"></i><%= u.phoneVerifiedAt ? t('verify.phone_ok') : t('verify.phone_not') %></span>
      <% if (u.verificationStatus === 'approved') { %><span class="tag-leaf"><i class="fa-solid fa-id-card" aria-hidden="true"></i><%= t('find.verified') %></span><% } %>
    </div>
    <a href="/settings" class="btn-plain mt-6 w-full sm:w-full"><i class="fa-solid fa-camera" aria-hidden="true"></i><%= t('account.edit_profile') %></a>
  </section>

  <%# everything else %>
  <section data-reveal="right">
    <ul class="grid gap-3 sm:grid-cols-2">
      <% links.forEach(function (l) { %>
        <li>
          <a href="<%= l[0] %>" class="flex h-full items-start gap-4 rounded-3xl bg-white p-5 text-ink no-underline shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-mist text-indigo"><i class="fa-solid <%= l[1] %>" aria-hidden="true"></i></span>
            <span><span class="block font-semibold"><%= l[2] %></span><span class="block text-[0.9rem] text-gray-600"><%= l[3] %></span></span>
          </a>
        </li>
      <% }) %>
    </ul>
    <form action="/logout" method="post" class="mt-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="inline-flex items-center gap-2 rounded-full px-4 py-2 font-medium text-full-tag hover:bg-full-bg"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><%= t('nav.logout') %></button>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
