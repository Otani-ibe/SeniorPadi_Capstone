<%- include('../partials/header') %>
<%
  const u = currentUser;
  const links = [
    ['/registrations', 'icon-ticket', t('stack.my_tickets'), t('account.tickets_hint', { count: ticketCount })],
    ['/settings', 'icon-sliders-horizontal', t('account.settings_link'), t('account.settings_hint')],
    ['/notifications', 'icon-bell', unreadCount > 0 ? t('nav.notifications_count', { count: unreadCount }) : t('nav.notifications'), t('account.notifications_hint')],
    ['/history', 'icon-history', t('nav.history'), t('account.history_hint')],
    ['/verify', 'icon-shield', t('account.verify_link'), u.contactVerified() ? t('account.verified_hint') : t('account.not_verified_hint')]
  ];
%>

<%# who you are %>
<section class="flex flex-col items-center gap-5 rounded-card bg-mist p-6 text-center sm:flex-row sm:text-left md:p-8">
  <%- include('../partials/avatar', { person: u, cls: 'h-28 w-28 shrink-0 ring-4 ring-white' }) %>
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-indigo"><%= t('account.title') %></p>
    <h1 class="text-[2rem] font-bold leading-tight tracking-tight"><%= u.fullName %></h1>
    <p class="mt-1 text-gray-700"><i class="icon-phone mr-1.5 text-indigo" aria-hidden="true"></i><%= u.localPhone() %></p>
    <% if (placeOf(u)) { %><p class="text-gray-700"><i class="icon-map-pin mr-1.5 text-indigo" aria-hidden="true"></i><%= placeOf(u) %></p><% } %>
    <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
      <span class="<%= u.phoneVerifiedAt ? 'tag-leaf' : 'tag-amber' %>"><i class="<%= u.phoneVerifiedAt ? 'icon-circle-check' : 'icon-circle-alert' %>" aria-hidden="true"></i><%= u.phoneVerifiedAt ? t('verify.phone_ok') : t('verify.phone_not') %></span>
      <% if (u.verificationStatus === 'approved') { %><span class="tag-leaf"><i class="icon-id-card" aria-hidden="true"></i><%= t('find.verified') %></span><% } %>
    </div>
  </div>
  <a href="/settings" class="btn-plain shrink-0"><i class="icon-camera" aria-hidden="true"></i><%= t('account.edit_profile') %></a>
</section>

<%# everything else, one tap each %>
<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  <% links.forEach(function (l) { %>
    <li>
      <a href="<%= l[0] %>" class="list-row h-full">
        <span class="icon-dot"><i class="<%= l[1] %>" aria-hidden="true"></i></span>
        <span class="min-w-0 flex-1">
          <span class="block text-[1.1rem] font-semibold"><%= l[2] %></span>
          <span class="block text-[0.95rem] text-gray-700"><%= l[3] %></span>
        </span>
        <i class="icon-chevron-right text-indigo" aria-hidden="true"></i>
      </a>
    </li>
  <% }) %>
</ul>

<form action="/logout" method="post" class="mt-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn-plain"><i class="icon-log-out" aria-hidden="true"></i><%= t('nav.logout') %></button>
</form>

<%- include('../partials/footer') %>
