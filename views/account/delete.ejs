<%- include('../partials/header') %>

<div class="mx-auto max-w-xl">
  <a href="/settings" class="back-link"><i class="icon-arrow-left" aria-hidden="true"></i><%= t('settings.title') %></a>

  <section class="sheet">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-full-bg text-[1.4rem] text-full-tag"><i class="icon-user-x" aria-hidden="true"></i></span>
    <h1 class="mt-4 text-[1.9rem] font-bold leading-tight"><%= t('delete.title') %></h1>
    <p class="mt-3 font-semibold"><%= t('delete.what_happens') %></p>
    <ul class="mt-3 space-y-2">
      <% ['delete.point_places', 'delete.point_login', 'delete.point_find'].forEach(function (k) { %>
        <li class="flex items-start gap-3 rounded-2xl bg-surface p-3.5"><i class="icon-circle-minus mt-1 text-full-tag" aria-hidden="true"></i><span><%= t(k) %></span></li>
      <% }) %>
    </ul>

    <% if (error) { %><div role="alert" class="mt-5 rounded-card bg-full-bg p-4 font-semibold"><%= error %></div><% } %>

    <p class="mt-6"><%= t('delete.confirm_intro', { phone: phone }) %></p>

    <% if (sent) { %>
      <form action="/account/delete" method="post" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/demoCode', { code: demoCode }) %>
        <div class="field">
          <label for="code"><%= t('verify.enter_code', { minutes: minutes }) %></label>
          <input type="text" id="code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required
                 class="text-center !text-[1.6rem] font-semibold tracking-[0.5em]">
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/settings" class="btn"><%= t('delete.keep') %></a>
          <button class="btn-coral"><%= t('delete.submit') %></button>
        </div>
      </form>
    <% } %>

    <form action="/account/delete/code" method="post" class="mt-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="flex flex-col gap-3 sm:flex-row">
        <% if (!sent) { %><a href="/settings" class="btn"><%= t('delete.keep') %></a><% } %>
        <button class="<%= sent ? 'btn-plain' : 'btn-coral' %>"><%= sent ? t('verify.send_again') : t('verify.send_sms') %></button>
      </div>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
