<%- include('../partials/header') %>

<a href="/account" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><%= t('nav.account') %></a>
<div class="page-head"><h1><%= t('settings.title') %></h1></div>

<div class="grid gap-6 md:grid-cols-[1fr_1.6fr] md:items-start">

  <%# ===== left: picture, then other things you can do ===== %>
  <div class="space-y-4 md:sticky md:top-28">
    <section class="sheet text-center">
      <h2 class="text-[1.3rem]"><%= t('settings.picture') %></h2>
      <%- include('../partials/avatar', { person: currentUser, cls: 'mx-auto mt-4 h-32 w-32 ring-4 ring-mist', alt: t('settings.picture_alt') }) %>
      <%# token goes in the URL because this is a file upload form %>
      <form action="/settings/profile-picture?_csrf=<%= encodeURIComponent(csrfToken) %>" method="post" enctype="multipart/form-data" data-upload class="mt-4 text-left">
        <div class="field">
          <label for="picture"><%= t('settings.picture_choose') %></label>
          <input type="file" id="picture" name="picture" accept="image/jpeg,image/png,image/webp" class="block w-full rounded-2xl border-2 border-dashed border-indigo/30 bg-mist p-3 text-[0.95rem]">
          <span class="hint"><%= t('settings.picture_hint') %></span>
        </div>
        <button class="btn-plain w-full sm:w-full" data-uploading-text="<%= t('upload.uploading') %>"><i class="fa-solid fa-upload" aria-hidden="true"></i><%= t('settings.picture_upload') %></button>
      </form>
    </section>
  </div>

  <%# ===== right: one form, in clear groups ===== %>
  <form action="/settings" method="post" class="space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="sheet">
      <h2 class="mb-4 flex items-center gap-3 text-[1.3rem]"><span class="icon-dot-soft h-10 w-10 text-[1rem]"><i class="fa-solid fa-user" aria-hidden="true"></i></span><%= t('settings.about_you') %></h2>
      <div class="field">
        <label for="bio"><%= t('settings.bio') %></label>
        <textarea id="bio" name="bio" rows="4" maxlength="500"><%= currentUser.bio || '' %></textarea>
        <span class="hint"><%= t('settings.bio_hint') %></span>
      </div>
      <%- include('../partials/lgaField', { id: 'lga', value: currentUser.lga }) %>
      <div class="field">
        <label for="area"><%= t('settings.area') %></label>
        <input type="text" id="area" name="area" value="<%= currentUser.area || '' %>">
        <span class="hint"><%= t('settings.area_hint') %></span>
      </div>
      <%- include('../partials/genderField', { idPrefix: 'gender', value: currentUser.gender }) %>
    </section>

    <section class="sheet">
      <h2 class="mb-4 flex items-center gap-3 text-[1.3rem]"><span class="icon-dot-soft h-10 w-10 text-[1rem]"><i class="fa-solid fa-language" aria-hidden="true"></i></span><%= t('settings.language') %></h2>
      <fieldset class="field">
        <legend class="sr-only"><%= t('settings.language') %></legend>
        <div class="grid grid-cols-2 gap-3">
          <% [['en', 'English'], ['yo', 'Yorùbá']].forEach(function (opt) { %>
            <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-2xl border-2 border-gray-300 bg-white px-4 font-semibold has-[:checked]:border-indigo has-[:checked]:bg-mist has-[:checked]:text-indigo">
              <input type="radio" name="preferredLanguage" value="<%= opt[0] %>" class="h-6 w-6 shrink-0 accent-indigo" <%= currentUser.preferredLanguage === opt[0] ? 'checked' : '' %>>
              <%= opt[1] %>
            </label>
          <% }) %>
        </div>
        <span class="hint"><%= t('settings.language_hint') %></span>
      </fieldset>
    </section>

    <section class="sheet">
      <h2 class="mb-4 flex items-center gap-3 text-[1.3rem]"><span class="icon-dot-soft h-10 w-10 text-[1rem]"><i class="fa-solid fa-bell" aria-hidden="true"></i></span><%= t('settings.reminders_title') %></h2>
      <label class="field flex min-h-14 cursor-pointer items-center gap-3 rounded-2xl bg-surface px-4 font-semibold">
        <input type="checkbox" name="remindersEnabled" value="yes" class="h-6 w-6 shrink-0 accent-indigo" <%= currentUser.remindersEnabled ? 'checked' : '' %>>
        <span><%= t('settings.remind_me') %></span>
      </label>
      <div class="field">
        <label for="reminderDaysBefore"><%= t('settings.reminder') %></label>
        <select id="reminderDaysBefore" name="reminderDaysBefore">
          <% [1, 2, 3, 7].forEach(function (d) { %>
            <option value="<%= d %>" <%= currentUser.reminderDaysBefore === d ? 'selected' : '' %>><%= d === 1 ? t('settings.reminder_one') : d === 7 ? t('settings.reminder_week') : t('settings.reminder_days', { days: d }) %></option>
          <% }) %>
        </select>
        <span class="hint"><%= t('settings.reminder_hint') %></span>
      </div>
    </section>

    <section class="sheet">
      <h2 class="mb-4 flex items-center gap-3 text-[1.3rem]"><span class="icon-dot-soft h-10 w-10 text-[1rem]"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span><%= t('settings.contact') %></h2>
      <div class="field">
        <label for="email"><%= t('signup.email') %></label>
        <input type="email" id="email" name="email" value="<%= currentUser.email || '' %>">
        <span class="hint"><%= t('signup.email_hint') %></span>
        <% if (errors.email) { %><span class="error"><%= errors.email %></span><% } %>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="<%= currentUser.phoneVerifiedAt ? 'tag-leaf' : 'tag-amber' %>"><%= currentUser.phoneVerifiedAt ? t('verify.phone_ok') : t('verify.phone_not') %></span>
        <% if (currentUser.email) { %><span class="<%= currentUser.emailVerifiedAt ? 'tag-leaf' : 'tag-amber' %>"><%= currentUser.emailVerifiedAt ? t('verify.email_ok') : t('verify.email_not') %></span><% } %>
        <% if (!currentUser.contactVerified()) { %><a href="/verify?next=/settings" class="font-semibold"><%= t('verify.do_it') %></a><% } %>
      </div>
    </section>

    <div>
      <button class="btn w-full sm:w-full"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><%= t('settings.save') %></button>
    </div>

    <section class="rounded-card bg-full-bg/60 p-5">
      <h2 class="text-[1.2rem]"><%= t('delete.title') %></h2>
      <p class="mt-1 text-gray-700"><%= t('delete.settings_intro') %></p>
      <a href="/account/delete" class="mt-2 inline-flex min-h-11 items-center gap-2 font-semibold text-full-tag"><i class="fa-solid fa-user-xmark" aria-hidden="true"></i><%= t('delete.title') %></a>
    </section>
  </form>
</div>

<script src="/js/upload.js" defer></script>
<%- include('../partials/footer') %>
