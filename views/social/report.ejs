<%- include('../partials/header') %>

<div class="mx-auto max-w-xl">
  <a href="/find-seniors" class="back-link"><i class="icon-arrow-left" aria-hidden="true"></i><%= t('common.go_back') %></a>

  <section class="sheet">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-full-bg text-[1.4rem] text-full-tag"><i class="icon-flag" aria-hidden="true"></i></span>
    <h1 class="mt-4 text-[1.9rem] font-bold leading-tight"><%= t('report.title_name', { name: other.firstName() }) %></h1>
    <p class="mt-3 font-semibold"><%= t('report.what_happens') %></p>
    <ul class="mt-3 space-y-2">
      <% [t('report.point_hide', { name: other.firstName() }), t('report.point_messages'), t('report.point_private', { name: other.firstName() })].forEach(function (p) { %>
        <li class="flex items-start gap-3 rounded-2xl bg-surface p-3.5"><i class="icon-circle-check mt-1 text-indigo" aria-hidden="true"></i><span><%= p %></span></li>
      <% }) %>
    </ul>

    <form action="/report/<%= other.id %>" method="post" class="mt-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="reason"><%= t('report.reason') %></label>
        <textarea id="reason" name="reason" rows="4" maxlength="1000"></textarea>
      </div>
      <button class="btn-coral"><i class="icon-flag" aria-hidden="true"></i><%= t('report.submit') %></button>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
