<%- include('../partials/header') %>
<% (typeof after !== 'undefined' ? after : []).forEach(function (p) { if (p.profilePictureUrl) { %><link rel="prefetch" as="image" href="<%= p.profilePictureUrl %>"><% } }) %>
<% const status = currentUser ? currentUser.verificationStatus : 'guest'; %>

<div class="mx-auto max-w-md">

<% if (status === 'approved') { %>
  <div class="mb-3 flex items-end justify-between gap-3">
    <div>
      <h1 class="text-[1.6rem] font-extrabold leading-tight tracking-tight text-slate-900 md:text-[1.9rem]"><%= t('find.title') %></h1>
      <p class="max-md:sr-only text-slate-600"><%= t('find.subtitle') %></p>
    </div>
    <% if (skippedCount > 0) { %>
      <a href="/find-seniors/skipped" class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-full bg-white px-4 font-semibold text-ink no-underline shadow-sm ring-1 ring-slate-200 hover:ring-indigo"><i class="icon-rotate-ccw" aria-hidden="true"></i><%= skippedCount %></a>
    <% } %>
  </div>

  <% if (next) { %>
    <%# one senior at a time, like a dating app: a big photo with their name over it. Drag right to say hello, left to skip
        (public/js/swipe.js). The round buttons below do the same. The whole introduction is shown. %>
    <div class="swipe-stack">
      <div class="swipe-peek rounded-[1.75rem] bg-slate-200" aria-hidden="true"></div>
      <article class="swipe-card w-full overflow-hidden rounded-[1.75rem] bg-white p-3 shadow-lg shadow-slate-900/10 ring-1 ring-slate-200"
               data-swipe-card tabindex="0" aria-label="<%= next.firstName() %>" data-left="skip-senior" data-right="message-senior">
        <%# the photo on its own: nothing is written over the face %>
        <div class="relative aspect-[5/4] max-h-[34dvh] w-full overflow-hidden rounded-[1.25rem] bg-slate-100 md:max-h-[38dvh]">
          <% if (next.profilePictureUrl) { %>
            <img src="<%= next.profilePictureUrl %>" alt="<%= next.firstName() %>" draggable="false" fetchpriority="high" decoding="async" width="600" height="600" class="absolute inset-0 h-full w-full select-none object-cover object-top">
          <% } else { %>
            <span class="absolute inset-0 flex items-center justify-center bg-mist"><img src="<%= next.avatarUrl() %>" alt="" draggable="false" class="h-3/4 w-3/4 select-none object-contain"></span>
          <% } %>
          <span class="absolute left-3 top-3 tag-leaf shadow"><i class="icon-circle-check" aria-hidden="true"></i><%= t('find.verified') %></span>
          <span class="presence-chip absolute right-3 top-3"><%- include('../partials/presence', { person: next }) %></span>
          <span class="swipe-badge deck-stamp deck-stamp-skip" data-badge="left"><%= t('find.skip') %></span>
          <span class="swipe-badge deck-stamp deck-stamp-yes" data-badge="right"><%= t('find.message_short') %></span>
        </div>

        <%# the name and a few words, under the photo %>
        <div class="px-2 pb-1 pt-4">
          <h2 class="text-[1.7rem] font-extrabold leading-tight tracking-tight text-slate-900"><%= next.firstName() %></h2>
          <% if (placeOf(next)) { %><p class="mt-1 flex items-center gap-2 text-slate-600"><i class="icon-map-pin text-indigo" aria-hidden="true"></i><%= placeOf(next) %></p><% } %>
          <p class="mt-2 whitespace-pre-line leading-snug text-slate-700"><%= next.tBio || next.bio || t('find.no_bio') %></p>
        </div>
      </article>
    </div>

    <%# two big round buttons with their words under them %>
    <div class="mt-5 flex items-start justify-center gap-10">
      <form id="skip-senior" action="/find-seniors/<%= next.id %>/skip" method="post" class="text-center">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="mx-auto flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-full bg-white text-[1.9rem] text-full-tag shadow-md ring-1 ring-slate-200 transition-colors hover:bg-full-bg" aria-label="<%= t('find.skip') %>"><i class="icon-x" aria-hidden="true"></i></button>
        <span class="mt-2 block font-semibold"><%= t('find.skip') %></span>
      </form>
      <a id="message-senior" href="/messages/<%= next.id %>" class="text-center text-ink no-underline">
        <span class="mx-auto flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-full bg-indigo text-[1.9rem] text-white shadow-md transition-colors hover:bg-indigo-dark"><i class="icon-message-circle-more" aria-hidden="true"></i></span>
        <span class="mt-2 block font-semibold"><%= t('find.message_short') %></span>
      </a>
    </div>
    <p class="mt-5 text-center"><a href="/report/<%= next.id %>" class="inline-flex min-h-12 items-center gap-2 font-semibold text-slate-600 no-underline hover:text-full-tag"><i class="icon-flag" aria-hidden="true"></i><%= t('find.report') %></a></p>
  <% } else { %>
    <div class="empty-state">
      <span class="icon-dot-soft mx-auto h-16 w-16 text-[1.5rem]"><i class="icon-users" aria-hidden="true"></i></span>
      <p class="mt-4 text-[1.15rem] font-medium"><%= t('find.seen_everyone') %></p>
      <a href="/messages" class="btn mt-5"><i class="icon-messages-square" aria-hidden="true"></i><%= t('find.go_messages') %></a>
    </div>
  <% } %>

<% } else { %>
  <%# locked until the ID is checked %>
  <div class="mb-6 text-center">
    <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full text-[2rem] <%= status === 'pending' ? 'bg-amber-bg text-amber-tag' : 'bg-mist text-indigo' %>">
      <%# the SeniorPadi mark, or an hourglass while their ID is being checked %>
      <% if (status === 'pending') { %><i class="icon-hourglass" aria-hidden="true"></i><% } else { %><%- include('../partials/logoMark', { size: 'h-11 w-11' }) %><% } %>
    </span>
    <h1 class="mt-4 text-[2.1rem] font-bold leading-tight tracking-tight"><%= t('find.title') %></h1>
    <p class="mx-auto mt-2 max-w-md text-[1.1rem] text-gray-700"><%= t('find.intro') %></p>
  </div>

  <% if (status === 'guest') { %>
    <p class="panel text-center"><%= t('find.why_id') %></p>
    <%- include('../partials/loginModal', {
          heading: t('modal.title_seniors'),
          mode: modalMode,
          switchHref: '/find-seniors?mode=' + (modalMode === 'signup' ? 'login' : 'signup') + '#login',
          next: '/find-seniors',
          closeHref: '/' }) %>

  <% } else if (status === 'pending') { %>
    <div class="rounded-card bg-amber-bg/60 p-6 text-center">
      <p class="text-[1.25rem] font-semibold"><%= t('find.pending') %></p>
      <p class="mt-2 text-gray-700"><%= t('find.pending_more') %></p>
      <a href="/events" class="btn mt-5"><i class="icon-calendar-days" aria-hidden="true"></i><%= t('nav.find_events') %></a>
    </div>

  <% } else if (status === 'social_removed') { %>
    <div class="empty-state">
      <p class="text-[1.1rem]"><%= t('find.removed') %></p>
      <a href="/events" class="btn mt-5"><%= t('nav.find_events') %></a>
    </div>

  <% } else { %>
    <% if (status === 'rejected') { %>
      <div role="alert" class="mb-5 rounded-card bg-full-bg p-4">
        <p class="font-semibold"><%= t('find.rejected') %></p>
        <p><%= currentUser.verificationRejectionReason %></p>
      </div>
    <% } %>

    <%# three short steps, then the upload %>
    <ol class="mb-5 grid gap-2">
      <% [['icon-id-card', 'find.step_upload'], ['icon-shield-check', 'find.step_check'], ['icon-messages-square', 'find.step_meet']].forEach(function (s, i) { %>
        <li class="flex items-center gap-3 rounded-2xl bg-surface p-3.5">
          <span class="icon-dot h-10 w-10 text-[1rem]"><i class="<%= s[0] %>" aria-hidden="true"></i></span>
          <span class="font-medium"><%= t(s[1]) %></span>
        </li>
      <% }) %>
    </ol>
    <p class="mb-5 text-center text-gray-700"><%= t('find.why_id') %></p>

    <form action="/find-seniors/id?_csrf=<%= encodeURIComponent(csrfToken) %>" method="post" enctype="multipart/form-data" data-upload>
      <label for="idDocument" class="mb-4 block cursor-pointer rounded-card border-2 border-dashed border-indigo/40 bg-mist/60 p-7 text-center transition hover:border-indigo hover:bg-mist">
        <i class="icon-cloud-upload text-[2.4rem] text-indigo" aria-hidden="true"></i>
        <span class="mt-2 block text-[1.15rem] font-semibold text-indigo"><%= t('find.id_label') %></span>
        <span class="mt-1 block text-[0.95rem] text-gray-700"><%= t('find.id_hint') %></span>
        <input type="file" id="idDocument" name="idDocument" accept="image/jpeg,image/png,application/pdf" class="mx-auto mt-4 block w-full max-w-full text-[0.95rem]">
      </label>
      <button class="btn w-full sm:w-full" data-uploading-text="<%= t('upload.uploading') %>"><i class="icon-send" aria-hidden="true"></i><%= status === 'rejected' ? t('find.id_resend') : t('find.id_send') %></button>
    </form>
    <p class="mt-4 text-center text-gray-700"><%= t('find.events_unaffected') %></p>
    <script src="/js/upload.js" defer></script>
  <% } %>
<% } %>

</div>

<%- include('../partials/footer') %>
