<%- include('../partials/header') %>

<%# a chat app: the people on the left; on a wide screen a note on the right until someone is chosen %>
<div class="chat-shell chat-shell-nav mx-auto flex w-full max-w-6xl overflow-hidden bg-white md:my-4 md:rounded-[1.5rem] md:shadow-md md:shadow-slate-900/5 md:ring-1 md:ring-slate-200">
  <%- include('../partials/chatList', { activeId: null }) %>
  <section class="hidden min-w-0 flex-1 flex-col items-center justify-center bg-slate-50 p-8 text-center md:flex">
    <span class="icon-dot-soft h-20 w-20 text-[2rem]"><i class="icon-messages-square" aria-hidden="true"></i></span>
    <h2 class="mt-5 text-[1.5rem]"><%= t('messages.pick') %></h2>
    <p class="mt-2 text-gray-700"><%= t('messages.pick_hint') %></p>
  </section>
</div>

<%- include('../partials/footer') %>
