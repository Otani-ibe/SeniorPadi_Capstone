<%- include('../partials/header') %>

<div class="mx-auto max-w-xl">
  <a href="/messages/<%= other.id %>" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><%= t('common.go_back') %></a>

  <section class="sheet">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-full-bg text-[1.4rem] text-full-tag"><i class="fa-solid fa-ban" aria-hidden="true"></i></span>
    <h1 class="mt-4 text-[1.9rem] font-bold leading-tight"><%= t('block.title_name', { name: other.firstName() }) %></h1>
    <p class="mt-3 text-[1.05rem] text-gray-700"><%= t('block.explain', { name: other.firstName() }) %></p>
    <p class="mt-4 rounded-2xl bg-amber-bg p-4 font-semibold"><i class="fa-solid fa-circle-exclamation mr-2 text-amber-tag" aria-hidden="true"></i><%= t('block.permanent') %></p>

    <form action="/block/<%= other.id %>" method="post" class="mt-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-coral"><i class="fa-solid fa-ban" aria-hidden="true"></i><%= t('block.submit', { name: other.firstName() }) %></button>
    </form>
    <p class="mt-5"><%= t('block.report_instead') %> <a href="/report/<%= other.id %>" class="font-semibold"><%= t('find.report') %></a></p>
  </section>
</div>

<%- include('../partials/footer') %>
