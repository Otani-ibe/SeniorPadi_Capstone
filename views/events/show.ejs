<%- include('../partials/header') %>

<a href="/events" class="back-link"><i class="icon-arrow-left" aria-hidden="true"></i><%= t('events.back') %></a>

<%# on a phone: name, then picture, then details. On a wide screen the picture is on the left. %>
<div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:grid-rows-[auto_1fr] lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] md:gap-x-10 md:gap-y-0">
  <div class="text-center md:col-start-2 md:row-start-1 md:text-left">
    <h1 class="text-[2rem] font-bold leading-tight tracking-tight md:text-[2.4rem]"><%= event.tTitle || event.title %></h1>
    <% if (event.Organization) { %><p class="mt-2 text-[1.05rem] text-gray-700"><%= t('stack.hosted_by', { org: event.Organization.name }) %></p><% } %>
    <div class="mt-3 [&>div]:justify-center md:[&>div]:justify-start"><%- include('../partials/eventTags', { event, state, isMine: mine.attendee }) %></div>
  </div>

  <%# the picture: nothing is drawn over it, so the whole flyer can be read %>
  <div class="relative self-start md:col-start-1 md:row-span-2 md:row-start-1">
    <%- include('../partials/eventImage', { event, natural: true, imgClass: 'block w-full rounded-card' }) %>
  </div>

  <div class="md:col-start-2 md:row-start-2">
    <%# when and where, as big readable rows %>
    <ul class="space-y-3 md:mt-5">
      <li class="flex items-start gap-3">
        <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="icon-calendar" aria-hidden="true"></i></span>
        <span><span class="font-semibold"><%= formatDate(event.startsAt) %></span><br><%= formatTime(event.startsAt) %> – <%= formatTime(event.endsAt) %></span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="icon-map-pin" aria-hidden="true"></i></span>
        <span>
          <span class="font-semibold"><%= event.area ? t('area.' + event.area) : t('events.area_unconfirmed') %></span><br><%= event.locationText %>
          <% if (event.locationMapsUrl) { %><br><a href="<%= event.locationMapsUrl %>" rel="noopener" target="_blank" class="inline-flex min-h-12 items-center" aria-label="<%= forEvent(t('event.open_map'), event) %>"><%= t('event.open_map') %></a><% } %>
        </span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="<%= event.priceLabel() ? 'icon-tag' : 'icon-gift' %>" aria-hidden="true"></i></span>
        <span><span class="font-semibold"><%= t('events.price') %></span><br><%= event.priceLabel() || t('events.free') %></span>
      </li>
      <% if (state.isOpen) { %>
        <li class="flex items-start gap-3">
          <span class="flex w-7 shrink-0 justify-center pt-0.5 text-[1.35rem] text-gray-700"><i class="icon-hourglass" aria-hidden="true"></i></span>
          <span><span class="font-semibold"><%= t('event.deadline') %></span><br><%= formatDate(event.registrationDeadline) %>, <%= formatTime(event.registrationDeadline) %></span>
        </li>
      <% } %>
    </ul>
    <%- include('../partials/slotsLeft', { id: event.id, slotsLeft: state.slotsLeft, cls: 'mt-4 text-[1.1rem]' }) %>

    <h2 class="mt-6 text-[1.2rem] text-indigo"><%= t('stack.about_event') %></h2>
    <p class="mt-1 whitespace-pre-line text-[1.05rem] text-gray-700"><%= event.tDescription || event.description %></p>
  </div>
</div>

<%# ================= JOIN ================= %>
<section class="panel mt-8 md:p-8" aria-labelledby="join-heading">
  <h2 id="join-heading" class="text-[1.5rem]"><%= t('event.join_title') %></h2>

  <% if (state.isCancelled) { %>
    <p class="mt-2"><%= t('event.cancelled_note') %></p>

  <% } else if (!state.isOpen) { %>
    <p class="mt-2"><%= state.isPast ? t('event.past_note') : t('event.closed_note') %></p>

  <% } else if (!currentUser && bookingFor) { %>
    <div class="mt-4 max-w-md"><%- include('../partials/bookButton', { event }) %></div>

  <% } else if (!currentUser) { %>
    <p class="mt-2"><%= t('event.login_to_join') %></p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <%# both links remember this event, so once the code is typed they are registered for it %>
      <a href="/signup?register=<%= event.id %>" class="btn"><%= t('home.create_account') %></a>
      <a href="/login?register=<%= event.id %>" class="btn-outline"><%= t('home.login') %></a>
    </div>
    <div class="text-left"><%- include('../partials/bookLink', { event }) %></div>

  <% } else { %>
    <div class="mt-4 grid gap-4 <%= state.volunteerEnabled ? 'sm:grid-cols-2' : 'max-w-md' %>">
      <%# attend %>
      <div class="rounded-card bg-white p-5">
        <% if (mine.attendee) { %>
          <p class="mb-3 flex items-center gap-2 font-semibold text-leaf"><i class="icon-circle-check" aria-hidden="true"></i><%= t('event.you_are_going') %></p>
          <a href="/registrations" class="btn-plain w-full sm:w-full"><%= t('event.manage') %></a>
        <% } else if (state.attendeeFull) { %>
          <button class="btn w-full sm:w-full" disabled><%= t('tag.full') %></button>
        <% } else { %>
          <form action="/events/<%= event.id %>/register" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn w-full sm:w-full" aria-label="<%= forEvent(t('event.register'), event) %>"><i class="icon-check" aria-hidden="true"></i><%= t('event.register') %></button>
          </form>
        <% } %>
      </div>

      <%# volunteer: same size and weight as attending %>
      <% if (state.volunteerEnabled) { %>
        <div class="rounded-card bg-white p-5">
          <% if (mine.volunteer) { %>
            <p class="mb-3 flex items-center gap-2 font-semibold text-leaf"><i class="icon-circle-check" aria-hidden="true"></i><%= t('event.you_are_volunteering') %></p>
            <a href="/registrations" class="btn-plain w-full sm:w-full"><%= t('event.manage') %></a>
          <% } else if (state.volunteerFull) { %>
            <button class="btn-volunteer w-full sm:w-full" disabled><%= t('tag.volunteer_full') %></button>
          <% } else { %>
            <form action="/events/<%= event.id %>/volunteer" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn-volunteer w-full sm:w-full" aria-label="<%= forEvent(t('event.volunteer'), event) %>"><i class="icon-hand-heart" aria-hidden="true"></i><%= t('event.volunteer') %></button>
            </form>
          <% } %>
          <p class="mt-2 text-gray-700"><%= t('event.volunteer_hint') %></p>
        </div>
      <% } %>
    </div>

    <%# calm alternative when it's full %>
    <% if (state.attendeeFull && !mine.attendee) { %>
      <div class="mt-5 rounded-card bg-white p-5">
        <% if (interested) { %>
          <p class="font-semibold"><%= t('notify_me.already') %></p>
        <% } else { %>
          <p class="mb-3"><%= t('notify_me.offer') %></p>
          <form action="/events/<%= event.id %>/notify-me" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn-plain"><i class="icon-bell" aria-hidden="true"></i><%= t('notify_me.button') %></button>
          </form>
        <% } %>
      </div>
    <% } %>
  <% } %>
</section>

<script src="/js/slots-live.js" defer></script>
<%- include('../partials/footer') %>
