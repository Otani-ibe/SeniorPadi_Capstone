<%- include('../partials/header') %>
<%
  const steps = [{ channel: 'phone', icon: 'icon-smartphone', done: Boolean(currentUser.phoneVerifiedAt), label: t('verify.phone_label', { phone: currentUser.localPhone() }) }];
  if (currentUser.email) steps.push({ channel: 'email', icon: 'icon-mail', done: Boolean(currentUser.emailVerifiedAt), label: t('verify.email_label', { email: currentUser.email }) });
%>

<div class="mx-auto max-w-xl">
  <div class="page-head text-center">
    <span class="icon-dot mx-auto h-16 w-16 text-[1.6rem]"><i class="icon-shield" aria-hidden="true"></i></span>
    <h1 class="mt-4"><%= t('verify.title') %></h1>
    <p class="lead mx-auto"><%= t('verify.intro') %></p>
  </div>

  <ol class="space-y-4">
    <% steps.forEach(function (step, i) { %>
      <li class="sheet <%= step.done ? 'border-leaf/40 bg-emerald-50' : '' %>">
        <p class="flex items-center gap-3 text-[1.1rem] font-semibold">
          <span class="<%= step.done ? 'icon-dot bg-leaf' : 'icon-dot-soft' %>"><i class="<%= step.done ? 'icon-check' : step.icon %>" aria-hidden="true"></i></span>
          <span><%= i + 1 %>. <%= step.label %></span>
        </p>

        <% if (step.done) { %>
          <p class="mt-3 font-semibold text-leaf"><%= t('verify.done') %></p>
        <% } else { %>
          <% if (sent === step.channel) { %>
            <form action="/verify/check" method="post" class="mt-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="channel" value="<%= step.channel %>">
              <div class="field mb-3">
                <label for="code-<%= step.channel %>"><%= t('verify.enter_code', { minutes: minutes }) %></label>
                <input type="text" id="code-<%= step.channel %>" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required
                       class="text-center !text-[1.6rem] font-semibold tracking-[0.5em]">
              </div>
              <button class="btn w-full sm:w-full"><%= t('verify.confirm') %></button>
            </form>
          <% } %>
          <form action="/verify/send" method="post" class="mt-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="channel" value="<%= step.channel %>">
            <button class="<%= sent === step.channel ? 'btn-plain' : 'btn' %> w-full sm:w-full">
              <%= sent === step.channel ? t('verify.send_again') : (step.channel === 'phone' ? t('verify.send_sms') : t('verify.send_email')) %>
            </button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ol>

  <p class="mt-6 rounded-2xl bg-surface p-4 text-center text-gray-700"><i class="icon-phone mr-2 text-indigo" aria-hidden="true"></i><%= t('verify.help', { phone: supportPhone }) %></p>
</div>

<%- include('../partials/footer') %>
