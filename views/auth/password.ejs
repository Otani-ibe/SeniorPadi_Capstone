<%- include('../partials/header') %>

<div class="auth-shell">
  <%- include('../partials/authAside') %>
  <div class="auth-form">
<span class="icon-dot mb-4 h-14 w-14 text-[1.4rem]"><i class="fa-solid fa-user-shield" aria-hidden="true"></i></span>
<h1 class="mb-2"><%= t('login.staff_title') %></h1>
<p class="mb-6"><%= phone %></p>

<% if (error) { %>
  <div role="alert" class="mb-6 flex items-start gap-3 rounded-card bg-full-bg p-4 font-semibold"><i class="fa-solid fa-circle-exclamation mt-0.5 text-[1.2rem] text-full-tag" aria-hidden="true"></i><%= error %></div>
<% } %>

<form action="/login/password" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="password"><%= t('signup.password') %></label>
    <input type="password" id="password" name="password" autocomplete="current-password" required autofocus data-password>
  </div>
  <%- include('../partials/showPassword', { id: 'show-password' }) %>
  <button class="btn w-full sm:w-full"><%= t('login.submit') %></button>
</form>

<p class="mt-6"><a href="/login" class="font-semibold"><%= t('login.wrong_number') %></a></p>
  </div>
</div>

<%- include('../partials/footer') %>
