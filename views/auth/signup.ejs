<%- include('../partials/header') %>

<div class="auth-shell">
  <%- include('../partials/authAside') %>
  <div class="auth-form">
<h1 class="mb-2"><%= t('signup.title') %></h1>
<p class="mb-2"><%= t('signup.intro') %></p>
<p class="mb-6 flex items-start gap-3 rounded-2xl bg-mist p-4"><i class="icon-smartphone mt-1 text-indigo" aria-hidden="true"></i><span><%= t('signup.code_note') %></span></p>

<form action="/signup" method="post" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="registerEventId" value="<%= typeof after !== 'undefined' ? after.registerEventId : '' %>">
  <input type="hidden" name="next" value="<%= typeof after !== 'undefined' ? after.next : '' %>">
  <input type="hidden" name="from" value="<%= typeof after !== 'undefined' && after.home ? 'home' : '' %>">

  <div class="field">
    <label for="fullName"><%= t('signup.name') %></label>
    <input type="text" id="fullName" name="fullName" value="<%= values.fullName || '' %>" autocomplete="name" required>
    <% if (errors.fullName) { %><span class="error"><%= errors.fullName %></span><% } %>
  </div>

  <div class="field">
    <label for="phone"><%= t('signup.phone') %></label>
    <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: values.phone }) %>
    <span class="hint"><%= t('signup.phone_hint') %></span>
    <% if (errors.phone) { %><span class="error"><%= errors.phone %></span><% } %>
  </div>

  <div class="field">
    <label class="flex items-start gap-3 font-normal">
      <input type="checkbox" name="ageDeclared" value="yes" class="mt-1 h-7 w-7 shrink-0" <%= values.ageDeclared ? 'checked' : '' %>>
      <span><strong><%= t('signup.age') %></strong></span>
    </label>
    <% if (errors.ageDeclared) { %><span class="error"><%= errors.ageDeclared %></span><% } %>
  </div>

  <button class="btn w-full sm:w-full"><%= t('signup.submit') %></button>
</form>

<p class="mt-6"><%= t('home.have_account') %> <a href="/login"><%= t('home.login') %></a></p>

<%- include('../partials/parentButton') %>
  </div>
</div>

<%- include('../partials/footer') %>
