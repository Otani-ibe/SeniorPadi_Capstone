<%- include('../partials/header') %>

<h1 class="mb-4"><%= t('forgot.title') %></h1>

<% if (sent) { %>
  <div class="panel">
    <p class="mb-3"><%= t('forgot.sent_email') %></p>
    <p><%= t('forgot.sent_no_email', { phone: supportPhone }) %></p>
  </div>
  <p class="mt-6"><a href="/login"><%= t('forgot.back') %></a></p>
<% } else { %>
  <p class="mb-6"><%= t('forgot.intro') %></p>
  <form action="/forgot-password" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="phone"><%= t('signup.phone') %></label>
      <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: '' }) %>
    </div>
    <button class="btn"><%= t('forgot.submit') %></button>
  </form>
<% } %>

<%- include('../partials/footer') %>
