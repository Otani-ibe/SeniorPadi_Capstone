<%- include('../partials/header') %>

<div class="auth-shell">
  <%- include('../partials/authAside') %>
  <div class="auth-form">
<span class="icon-dot mb-4 h-14 w-14 text-[1.4rem]"><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i></span>
<h1 class="mb-2"><%= t('login.code_title') %></h1>
<p class="mb-6"><%= t('login.code_sent', { phone: phone }) %></p>

<form action="/login/code" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field mb-3">
    <label for="code"><%= t('verify.enter_code', { minutes: minutes }) %></label>
    <input type="text" id="code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required autofocus
           class="text-center !text-[1.6rem] font-semibold tracking-[0.5em]">
  </div>
  <button class="btn w-full sm:w-full"><%= t('verify.confirm') %></button>
</form>

<%# didn't get it? ask again (they can wait a minute between asks) %>
<form action="/login/code/resend" method="post" class="mt-3">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn-plain w-full sm:w-full"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i><%= t('verify.send_again') %></button>
</form>

<p class="mt-6"><a href="/login" class="font-semibold"><%= t('login.wrong_number') %></a></p>
  </div>
</div>

<%- include('../partials/footer') %>
