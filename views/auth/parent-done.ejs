<%- include('../partials/header') %>

<div class="mx-auto max-w-xl py-6 text-center">
  <span class="done-pop mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-leaf text-[2.2rem] text-white"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
  <h1 class="mt-5 text-[2rem] font-bold leading-tight"><%= t('parent.done_title') %></h1>
  <p class="mt-3 text-[1.2rem] font-semibold"><%= t('parent.done_child', { name: parentName }) %></p>
  <p class="mt-2 text-gray-700"><%= t('parent.done_texts', { name: parentFirst }) %></p>
  <p class="mx-auto mt-5 max-w-md rounded-card bg-mist p-4 text-gray-700"><%= t('parent.done_next', { name: parentFirst }) %></p>
  <p class="mx-auto mt-3 max-w-md rounded-card bg-amber-bg p-4 font-semibold text-amber-tag"><%= t('parent.done_book', { name: parentFirst }) %></p>
  <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
    <a href="/events" class="btn"><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i><%= t('book.after_signup', { name: parentFirst }) %></a>
    <a href="/" class="btn-plain"><%= t('error.go_home') %></a>
  </div>
</div>

<%- include('../partials/footer') %>
