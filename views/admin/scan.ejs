<%- include('../partials/header') %>
<%# opened by scanning a senior's QR code with a phone camera %>

<div class="mx-auto max-w-md">
  <h1 class="mb-4 text-[1.6rem]">Check in</h1>

  <% if (!registration) { %>
    <div class="admin-box p-6 text-center">
      <p class="font-semibold">This code doesn't match any ticket.</p>
      <p class="mt-1 text-gray-600">Find them by name on the event's attendance list instead.</p>
    </div>
  <% } else { const r = registration; %>
    <div class="admin-box p-6 text-center">
      <% if (r.senior) { %><%- include('../partials/avatar', { person: r.senior, cls: 'mx-auto h-24 w-24' }) %><% } %>
      <p class="mt-4 text-[1.5rem] font-semibold leading-tight"><%= r.senior ? r.senior.fullName : '(deleted account)' %></p>
      <p class="mt-1 text-gray-600"><%= r.type === 'volunteer' ? 'Volunteer' : 'Attendee' %> · <%= r.ticketNumber %></p>
      <div class="mt-4 border-t border-gray-100 pt-4">
        <p class="font-semibold"><%= r.Event.title %></p>
        <p class="text-[0.95rem] text-gray-600"><%= formatDate(r.Event.startsAt) %>, <%= formatTime(r.Event.startsAt) %></p>
      </div>

      <% if (r.status === 'attended') { %>
        <p class="mt-5 flex items-center justify-center gap-2 rounded-md bg-emerald-50 p-4 text-[1.2rem] font-semibold text-leaf-dark"><%- include('../partials/icon', { name: 'check', cls: 'h-6 w-6' }) %>Checked in</p>
      <% } else if (r.status === 'cancelled') { %>
        <p class="mt-5 rounded-md bg-full-bg p-4 font-semibold text-full-tag">This place was cancelled. If they're here, welcome them and tick them on the attendance list.</p>
      <% } else { %>
        <form action="/admin/scan/<%= r.qrToken %>" method="post" class="mt-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="inline-flex min-h-14 w-full items-center justify-center rounded-md bg-leaf text-[1.2rem] font-semibold text-white transition hover:bg-leaf-dark">Came</button>
        </form>
      <% } %>
    </div>

    <a href="/admin/events/<%= r.Event.id %>/attendance" class="back-link mt-4">Open the full list for this event</a>
  <% } %>
</div>

<%- include('../partials/footer') %>
