<%- include('../partials/header') %>

<div class="admin-head">
  <div>
    <h1>Identity checks</h1>
    <p class="count">Seniors who sent their NIN. Open one to check it.</p>
  </div>
</div>

<% if (pending.length === 0) { %>
  <p class="admin-box flex items-center gap-2 p-6 text-slate-500"><%- include('../partials/icon', { name: 'check', cls: 'h-4 w-4 text-leaf' }) %>Nothing is waiting.</p>
<% } else { %>
  <ul class="admin-box divide-y divide-slate-100">
    <% pending.forEach(function (item) { const s = item.senior; %>
      <li class="flex flex-wrap items-center gap-3 p-4 md:px-5">
        <span class="min-w-0 flex-1">
          <span class="block font-semibold"><%= s.fullName %></span>
          <span class="text-[0.9rem] text-slate-500"><%= s.phone %> &middot; sent <%= item.row ? formatDate(item.row.submittedAt) : formatDate(s.updatedAt) %></span>
          <% if (item.duplicate) { %><span class="mt-1 block"><span class="chip chip-amber">NIN already verified on another account</span></span><% } %>
        </span>
        <form action="/admin/ids/<%= s.id %>/show" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="abtn">Check NIN</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../partials/footer') %>
