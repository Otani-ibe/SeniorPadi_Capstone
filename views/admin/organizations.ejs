<%- include('../partials/header') %>

<h1 class="mb-6">Organizations</h1>

<% if (organizations.length === 0) { %>
  <p class="panel mb-8">No organizations yet. Add the first one below.</p>
<% } else { %>
  <ul class="mb-10 space-y-3">
    <% organizations.forEach(function (org) { %>
      <li class="rounded-[1.5rem] border-2 border-gray-100 bg-white p-5">
        <strong><%= org.name %></strong>
        <% if (org.contactName || org.contactPhone) { %><br><%= [org.contactName, org.contactPhone, org.contactEmail].filter(Boolean).join(', ') %><% } %>
        <br><a href="/admin/organizations/<%= org.id %>/edit">Edit</a>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2 class="mb-4">Add an organization</h2>
<% if (error) { %><div role="alert" class="mb-4 rounded-[1.25rem] bg-full-bg p-4 font-semibold"><%= error %></div><% } %>
<form action="/admin/organizations" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('orgFields', { org: {} }) %>
  <button class="btn">Add organization</button>
</form>

<%- include('../partials/footer') %>
