<%- include('../partials/header') %>
<%
  const action = event ? '/admin/events/' + event.id + '/edit' : '/admin/events';
  function err(name) { return errors[name] ? '<span class="error">' + errors[name] + '</span>' : ''; }
%>

<p class="mb-4"><a href="/admin/events">Back to events</a></p>
<h1 class="mb-6"><%= event ? 'Edit event' : 'New event' %></h1>

<% if (Object.keys(errors).length > 0) { %>
  <div role="alert" class="mb-6 rounded-card bg-full-bg p-4 font-semibold">Some things need fixing. They're marked below.</div>
<% } %>

<%# file upload form, so the CSRF token goes in the URL %>
<form action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" method="post" enctype="multipart/form-data" data-upload>
  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= values.title || '' %>">
    <%- err('title') %>
  </div>

  <div class="field">
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="5"><%= values.description || '' %></textarea>
    <span class="hint">Plain words. What happens, what to bring, who it's for.</span>
    <%- err('description') %>
  </div>

  <div class="field">
    <label for="organizationId">Organization</label>
    <select id="organizationId" name="organizationId">
      <option value="">Choose one</option>
      <% organizations.forEach(function (org) { %>
        <option value="<%= org.id %>" <%= Number(values.organizationId) === org.id ? 'selected' : '' %>><%= org.name %></option>
      <% }) %>
    </select>
    <%- err('organizationId') %>
  </div>

  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category">
      <option value="">Choose one</option>
      <% categories.forEach(function (c) { %>
        <option value="<%= c %>" <%= values.category === c ? 'selected' : '' %>><%= t('category.' + c) %></option>
      <% }) %>
    </select>
    <%- err('category') %>
  </div>

  <div class="grid gap-x-4 sm:grid-cols-2">
    <div class="field">
      <label for="startsAt">Starts</label>
      <input type="datetime-local" id="startsAt" name="startsAt" value="<%= values.startsAt || '' %>">
      <%- err('startsAt') %>
    </div>
    <div class="field">
      <label for="endsAt">Ends</label>
      <input type="datetime-local" id="endsAt" name="endsAt" value="<%= values.endsAt || '' %>">
      <%- err('endsAt') %>
    </div>
  </div>

  <div class="field">
    <label for="registrationDeadline">Registration closes</label>
    <input type="datetime-local" id="registrationDeadline" name="registrationDeadline" value="<%= values.registrationDeadline || '' %>">
    <span class="hint">All times are Lagos time.</span>
    <%- err('registrationDeadline') %>
  </div>

  <div class="field">
    <label for="locationText">Where</label>
    <input type="text" id="locationText" name="locationText" value="<%= values.locationText || '' %>">
    <span class="hint">Write the full place with landmarks, e.g. Agodi Gardens, main gate, opposite the post office, Ibadan. Seniors get this exactly as written in their text message.</span>
    <%- err('locationText') %>
  </div>

  <div class="field">
    <label for="area">Local government area</label>
    <select id="area" name="area">
      <option value="">Choose one</option>
      <% areas.forEach(function (a) { %>
        <option value="<%= a %>" <%= values.area === a ? 'selected' : '' %>><%= t('area.' + a) %></option>
      <% }) %>
    </select>
    <span class="hint">Seniors see events in their own area first, so every event needs one.</span>
    <%- err('area') %>
  </div>

  <div class="field">
    <label for="locationMapsUrl">Google Maps link (optional)</label>
    <input type="url" id="locationMapsUrl" name="locationMapsUrl" value="<%= values.locationMapsUrl || '' %>">
    <%- err('locationMapsUrl') %>
  </div>

  <div class="field">
    <label for="capacity">How many seniors can attend?</label>
    <input type="number" id="capacity" name="capacity" min="1" value="<%= values.capacity || '' %>">
    <span class="hint">Seniors see how many slots are left, and the number goes down as they register. You can raise or lower it later. Leave it empty for no limit, and no number is shown.</span>
    <%- err('capacity') %>
  </div>

  <%# free or paid. Seniors only ever see a price on paid events. %>
  <fieldset class="field" data-pricing>
    <legend>Does it cost anything?</legend>
    <div class="grid grid-cols-2 gap-3">
      <% [['free', 'No, it costs nothing'], ['paid', 'Yes, it is paid']].forEach(function (opt) { %>
        <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-2xl border-2 border-gray-300 bg-white px-4 font-semibold has-[:checked]:border-indigo has-[:checked]:bg-mist has-[:checked]:text-indigo">
          <input type="radio" name="pricing" value="<%= opt[0] %>" class="h-6 w-6 shrink-0 accent-indigo" <%= (values.pricing || 'free') === opt[0] ? 'checked' : '' %>>
          <%= opt[1] %>
        </label>
      <% }) %>
    </div>
    <div class="mt-4" data-price-box>
      <label for="price">Price per senior (naira)</label>
      <span class="relative block">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 font-semibold text-gray-700">₦</span>
        <input type="text" id="price" name="price" inputmode="numeric" placeholder="2000" value="<%= values.price || '' %>" class="!pl-9">
      </span>
      <span class="hint">Seniors see this on the event card, e.g. ₦2,000. Only needed for paid events.</span>
      <%- err('price') %>
    </div>
  </fieldset>
  <script>
    // only show the price box for paid events
    (function () {
      var box = document.querySelector('[data-price-box]');
      var radios = document.querySelectorAll('[data-pricing] input[name="pricing"]');
      function sync() { box.hidden = !document.querySelector('[data-pricing] input[value="paid"]').checked; }
      radios.forEach(function (r) { r.addEventListener('change', sync); });
      sync();
    })();
  </script>

  <fieldset class="panel mb-5">
    <legend class="sr-only">Volunteers</legend>
    <label class="mb-3 flex items-center gap-3 font-bold">
      <input type="checkbox" name="volunteerEnabled" value="yes" class="h-6 w-6" <%= values.volunteerEnabled ? 'checked' : '' %>>
      Volunteers needed
    </label>
    <div class="field mb-0">
      <label for="volunteerCapacity">How many volunteers?</label>
      <input type="number" id="volunteerCapacity" name="volunteerCapacity" min="1" value="<%= values.volunteerCapacity || '' %>">
      <span class="hint">Separate from the attendee spots.</span>
      <%- err('volunteerCapacity') %>
    </div>
  </fieldset>

  <label class="field flex items-center gap-3 font-bold">
    <input type="checkbox" name="hostedBySenior" value="yes" class="h-6 w-6" <%= values.hostedBySenior ? 'checked' : '' %>>
    Hosted by a senior
  </label>

  <%# keep the file last so the text fields are read even if the file is too big %>
  <div class="field">
    <label for="image">Event picture</label>
    <label for="image" class="flex cursor-pointer flex-col items-center gap-3 rounded-3xl border-2 border-dashed border-indigo/30 bg-mist/50 p-5 text-center transition hover:border-indigo">
      <img id="image-preview" src="<%= event && event.imageUrl ? event.imageUrl : '' %>" <%= event && event.imageUrl ? '' : 'hidden' %>
           alt="Picture preview" class="h-48 w-full max-w-md rounded-2xl bg-mist object-contain shadow">
      <span class="font-medium text-indigo"><i class="fa-solid fa-image mr-2" aria-hidden="true"></i>Choose a photo</span>
      <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" class="w-full max-w-full text-[0.9rem]">
    </label>
    <span class="hint">Best size: a square flyer, 1080 x 1080 pixels. It is shown whole and never cropped. Keep the words away from the edges. JPG, PNG or WebP, up to 3MB. Without one, the event shows an empty picture space.</span>
  </div>

  <script>
    // show the chosen photo straight away
    document.getElementById('image').addEventListener('change', function (e) {
      var file = e.target.files[0];
      if (!file) return;
      var preview = document.getElementById('image-preview');
      preview.src = URL.createObjectURL(file);
      preview.hidden = false;
    });
  </script>

  <button class="btn" data-uploading-text="Saving…"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><%= event ? 'Save changes' : 'Publish event' %></button>
</form>

<script src="/js/upload.js" defer></script>
<%- include('../partials/footer') %>
