<%- include('../partials/header') %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1>Events</h1>
  <a href="/admin/events/new" class="btn">Add event</a>
</div>

<% if (events.length === 0) { %>
  <p class="panel">No events yet.</p>
<% } %>

<ul class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <% events.forEach(function (event) { %>
    <li class="flex gap-4 rounded-[1.5rem] border-2 border-gray-100 bg-white p-4">
      <%- include('../partials/eventImage', { event, imgClass: 'h-24 w-24 shrink-0 rounded-2xl object-cover object-top sm:h-28 sm:w-36' }) %>
      <div class="min-w-0 flex-1">
      <p class="mb-1">
        <% if (event.status === 'cancelled') { %><span class="tag-full">Cancelled</span>
        <% } else if (event.status === 'completed') { %><span class="tag-mine">Finished</span>
        <% } else { %><span class="tag-leaf">Published</span><% } %>
        <% if (event.hostedBySenior) { %><span class="tag-leaf">Hosted by a senior</span><% } %>
      </p>
      <h2 class="mb-1"><%= event.title %></h2>
      <p><%= formatDate(event.startsAt) %>, <%= formatTime(event.startsAt) %> at <%= event.locationText %></p>
      <p class="mb-3"><%= event.Organization.name %></p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/events/<%= event.id %>">View as senior</a>
        <a href="/admin/events/<%= event.id %>/edit">Edit</a>
        <a href="/admin/events/<%= event.id %>/attendance">Attendance</a>
        <% if (event.status === 'published') { %>
          <form action="/admin/events/<%= event.id %>/cancel" method="post" onsubmit="return confirm('Cancel this event? Everyone registered will get a message.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 font-semibold no-underline bg-full-bg text-full-tag hover:bg-full-tag hover:text-white">Cancel event</button>
          </form>
        <% } %>
      </div>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
