<%- include('../partials/header') %>
<%# adding a new organization (no id yet) or editing one %>

<a href="/admin/organizations" class="back-link"><i class="icon-arrow-left" aria-hidden="true"></i>Organizations</a>
<h1 class="mb-6 text-[1.9rem] leading-tight"><%= org.id ? 'Edit ' + org.name : 'Add an organization' %></h1>

<div class="max-w-2xl rounded-card border border-gray-200 bg-white p-5 md:p-8">
  <% if (error) { %><div role="alert" class="mb-5 rounded-md bg-full-bg p-4 font-semibold text-full-tag"><%= error %></div><% } %>
  <form action="<%= org.id ? '/admin/organizations/' + org.id + '/edit' : '/admin/organizations' %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('orgFields', { org, areas }) %>
    <div class="flex flex-wrap gap-3">
      <button class="btn"><%= org.id ? 'Save changes' : 'Add organization' %></button>
      <a href="/admin/organizations" class="btn-plain">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
