<%# the guest list with door check-in, shared by staff (admin/attendance) and the host organization (host/checkin).
    needs: event, registrations, counts, hasStarted, door ({ base: where the forms post, host: true on the organization's page })
    Script: public/js/admin-door.js. Everything also works without it (each tap reloads the page). %>
<% const pct = counts.total ? Math.round((counts.came / counts.total) * 100) : 0; %>

<%# the count at the top, kept up to date as people are ticked %>
<section class="admin-box mb-4 p-5" aria-live="polite">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <p><span class="text-[2rem] font-semibold leading-none tabular-nums" data-count="came"><%= counts.came %></span>
       <span class="text-gray-600">of <span data-count="total"><%= counts.total %></span> checked in</span></p>
    <p class="flex flex-wrap gap-1.5 text-[0.9rem]">
      <span class="chip chip-grey"><span data-count="waiting"><%= counts.waiting %></span>&nbsp;not marked</span>
      <% if (hasStarted) { %><span class="chip chip-amber"><span data-count="missed"><%= counts.missed %></span>&nbsp;didn't come</span><% } %>
    </p>
  </div>
  <div class="mt-3 h-2 rounded-full bg-gray-100"><div class="h-2 rounded-full bg-leaf transition-all duration-500" data-count-bar style="width: <%= pct %>%"></div></div>
</section>

<% if (registrations.length === 0) { %>
  <div class="admin-box px-6 py-12 text-center">
    <p class="font-semibold">Nobody is registered for this event yet.</p>
  </div>
<% } else { %>
  <%# the box: searches the list as you type. Pressing Enter checks in the one match,
      or, without JavaScript, checks in by ticket number %>
  <form action="<%= door.base %>/checkin" method="post" role="search" class="admin-box sticky top-0 z-10 mb-3 p-2 print:hidden md:top-2" data-door-search>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="flex gap-2">
      <div class="admin-search flex-1">
        <label for="ticket" class="sr-only">Find by name, phone or ticket number</label>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="ticket" name="ticket" autocomplete="off" autofocus placeholder="Name, phone or ticket" class="admin-input min-h-12 text-[1rem]">
      </div>
      <button class="admin-add min-h-12">Check in</button>
    </div>
    <div class="mt-2 flex flex-wrap gap-1.5 px-1 pb-1" role="group" aria-label="Show">
      <% [['all', 'Everyone'], ['registered', 'Not marked'], ['attended', 'Came']].concat(hasStarted ? [['no_show', "Didn't come"]] : []).forEach(function (f, i) { %>
        <button type="button" data-door-filter="<%= f[0] %>" aria-pressed="<%= i === 0 %>"
                class="rounded-md border px-3 py-1 text-[0.9rem] font-medium transition aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white border-gray-300 text-gray-700 hover:border-ink"><%= f[1] %></button>
      <% }) %>
    </div>
  </form>

  <ul class="admin-box divide-y divide-gray-100" data-door-list>
    <% registrations.forEach(function (reg) { %>
      <%- include('attendanceRow', { reg, event, hasStarted, door }) %>
    <% }) %>
  </ul>
  <p class="mt-3 hidden rounded-card border border-gray-200 bg-white px-5 py-6 text-center text-gray-600" data-door-empty>
    Nobody on the list matches. If they have a ticket number, type it in full and press Check in.
  </p>

  <% if (hasStarted && counts.waiting > 0) { %>
    <form action="<%= door.base %>/rest-missed" method="post" class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-card border border-gray-200 bg-white p-4 print:hidden"
          onsubmit="return confirm('Mark everyone still not marked as didn\'t come?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="text-[0.95rem] text-gray-700">Event over? Everyone you haven't ticked can be marked as didn't come in one go.</p>
      <button class="admin-plain">Mark the rest as didn't come</button>
    </form>
  <% } else if (!hasStarted && !door.host) { %>
    <p class="mt-5 text-[0.9rem] text-gray-600 print:hidden">Tip: open this page on a phone at the door, or send the organization its check-in link below.</p>
  <% } %>
<% } %>

<p class="sr-only" role="status" aria-live="assertive" data-door-said></p>
<script src="/js/admin-door.js" defer></script>
