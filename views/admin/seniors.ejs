<%- include('../partials/header') %>
<% const filtered = filters.q || filters.lga || filters.id;
   const idLabel = { unverified: ['Not sent', 'chip-grey'], pending: ['Waiting for check', 'chip-amber'], approved: ['Verified', 'chip-green'], rejected: ['Sent back', 'chip-red'], social_removed: ['Removed from social', 'chip-red'] }; %>

<div class="admin-head">
  <div>
    <h1>Seniors</h1>
    <p class="count"><%= filtered ? seniors.length + ' of ' + total : total %> senior<%= total === 1 ? '' : 's' %><%= seniors.length === 100 ? ' (first 100 shown; search to narrow down)' : '' %></p>
  </div>
</div>

<form action="/admin/seniors" method="get" role="search" class="admin-filters" data-filters>
  <div class="admin-search">
    <label for="q" class="sr-only">Search seniors</label>
    <i class="icon-search" aria-hidden="true"></i>
    <input type="search" id="q" name="q" value="<%= filters.q %>" placeholder="Search by name or phone" class="admin-input">
  </div>
  <label for="lga" class="sr-only">Local government area</label>
  <select id="lga" name="lga" class="admin-input">
    <option value="">All LGAs</option>
    <% areas.forEach(function (a) { %><option value="<%= a %>" <%= filters.lga === a ? 'selected' : '' %>><%= t('area.' + a) %></option><% }) %>
  </select>
  <label for="id" class="sr-only">ID check</label>
  <select id="id" name="id" class="admin-input">
    <option value="">Any ID status</option>
    <% idStatuses.forEach(function (s) { %><option value="<%= s %>" <%= filters.id === s ? 'selected' : '' %>><%= idLabel[s][0] %></option><% }) %>
  </select>
  <button class="admin-plain">Search</button>
</form>

<% if (seniors.length === 0) { %>
  <div class="admin-box px-6 py-12 text-center">
    <p class="font-semibold"><%= filtered ? 'No seniors match.' : 'No seniors have signed up yet.' %></p>
    <% if (filtered) { %><p class="mt-1"><a href="/admin/seniors">Clear the search</a></p><% } %>
  </div>
<% } else { %>
  <div class="admin-box overflow-x-auto">
    <table class="admin-table min-w-[48rem] [&_td]:align-middle">
      <thead><tr><th>Senior</th><th>Phone</th><th>LGA</th><th>Joined</th><th>ID check</th><th><span class="sr-only">Open</span></th></tr></thead>
      <tbody>
        <% seniors.forEach(function (s) { %>
          <tr class="hover:bg-surface">
            <td>
              <span class="flex items-center gap-3">
                <%- include('../partials/avatar', { person: s, cls: 'h-10 w-10 shrink-0' }) %>
                <span class="min-w-0">
                  <a href="/admin/seniors/<%= s.id %>" class="font-semibold text-ink no-underline hover:underline"><%= s.fullName %></a>
                  <% if (s.createdByName) { %><br><span class="text-[0.85rem] text-gray-600">Signed up by <%= s.createdByName %></span><% } %>
                </span>
              </span>
            </td>
            <td class="whitespace-nowrap"><%= s.localPhone() %></td>
            <td><%= s.lga ? t('area.' + s.lga) : '–' %></td>
            <td class="whitespace-nowrap"><%= formatDate(s.createdAt) %></td>
            <td><span class="chip <%= idLabel[s.verificationStatus][1] %>"><%= idLabel[s.verificationStatus][0] %></span></td>
            <td class="text-right"><a href="/admin/seniors/<%= s.id %>" class="admin-plain min-h-9 px-3 text-[0.9rem]">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<script src="/js/admin-filters.js" defer></script>
<%- include('../partials/footer') %>
