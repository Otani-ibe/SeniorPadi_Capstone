<%- include('../partials/header') %>

<h1 class="mb-6">Reports</h1>

<h2 class="mb-3">Waiting for review</h2>
<% if (pending.length === 0) { %>
  <p class="panel mb-10">No open reports.</p>
<% } else { %>
  <ul class="mb-10 space-y-3">
    <% pending.forEach(function (r) { %>
      <li class="border-b border-gray-300 pb-3">
        <a href="/admin/reports/<%= r.id %>"><strong><%= r.reporter ? r.reporter.fullName : '(deleted)' %></strong> reported <strong><%= r.reported ? r.reported.fullName : '(deleted)' %></strong></a><br>
        <span class="text-base"><%= formatDate(r.createdAt) %></span>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2 class="mb-3">Recently closed</h2>
<% if (recent.length === 0) { %>
  <p>None yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead><tr><th>Reported</th><th>Outcome</th><th>Closed</th></tr></thead>
    <tbody>
      <% recent.forEach(function (r) { %>
        <tr>
          <td><a href="/admin/reports/<%= r.id %>"><%= r.reported ? r.reported.fullName : '(deleted)' %></a></td>
          <td><%= { warned: 'Warned', removed: 'Removed from social', dismissed: 'Dismissed' }[r.status] %></td>
          <td><%= r.reviewedAt ? formatDate(r.reviewedAt) : '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
