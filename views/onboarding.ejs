<%- include('partials/header') %>

<div class="mx-auto max-w-3xl">
  <div class="page-head text-center">
    <%- include('partials/logoMark', { size: 'mx-auto h-16 w-16' }) %>
    <h1 class="mt-4"><%= t('onboarding.title') %></h1>
    <p class="lead mx-auto"><%= t('onboarding.intro') %></p>
  </div>

  <% if (videoSrc) { %>
    <%# preload="none": nothing downloads until they press play %>
    <video controls preload="none" playsinline class="aspect-video w-full rounded-[1.75rem] bg-indigo">
      <source src="<%= videoSrc %>" type="video/mp4">
    </video>
    <p class="mt-3 text-center text-gray-700"><%= t('onboarding.video_trouble') %></p>
  <% } %>

  <form action="/onboarding/done" method="post" class="mt-6 text-center">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn"><%= firstTime ? t('onboarding.continue') : t('onboarding.back_to_events') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
  </form>

  <section class="sheet mt-8">
    <h2 class="flex items-center gap-3 text-[1.4rem]"><span class="icon-dot-soft h-10 w-10 text-[1rem]"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><%= videoSrc ? t('onboarding.transcript') : t('onboarding.read_title') %></h2>
    <div class="mt-4 whitespace-pre-line text-[1.08rem] leading-relaxed text-gray-700"><%= transcript %></div>
  </section>

  <% if (firstTime) { %>
    <form action="/onboarding/done" method="post" class="mt-6 text-center">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="inline-flex min-h-11 items-center font-semibold text-indigo underline"><%= t('onboarding.skip') %></button>
    </form>
  <% } %>
</div>

<%- include('partials/footer') %>
