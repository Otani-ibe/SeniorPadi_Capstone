<%- include('partials/header') %>

<%# plain words, one heading and a short paragraph or list for each part %>
<%
  const SECTIONS = [
    { title: 'privacy.who_title', text: 'privacy.who_text' },
    { title: 'privacy.keep_title', list: ['privacy.keep1', 'privacy.keep2', 'privacy.keep3', 'privacy.keep4', 'privacy.keep5'] },
    { title: 'privacy.why_title', text: 'privacy.why_text' },
    { title: 'privacy.nin_title', text: 'privacy.nin_text' },
    { title: 'privacy.see_title', text: 'privacy.see_text' },
    { title: 'privacy.services_title', text: 'privacy.services_text' },
    { title: 'privacy.can_title', list: ['privacy.can1', 'privacy.can2', 'privacy.can3', 'privacy.can4'] },
    { title: 'privacy.family_title', text: 'privacy.family_text' },
    { title: 'privacy.safe_title', text: 'privacy.safe_text' }
  ];
%>

<section class="max-w-3xl">
  <h1 class="text-[2.1rem] font-bold leading-[1.1] tracking-tight [overflow-wrap:anywhere] min-[400px]:text-[2.4rem] md:text-[3rem]"><%= t('privacy.title') %></h1>
  <% if (lang === 'yo') { %>
    <p class="mt-4 rounded-2xl bg-mist p-4 text-[1.1rem] font-semibold text-indigo"><%= t('privacy.yo_note') %></p>
  <% } %>
  <p class="mt-3 text-gray-700"><%= t('privacy.updated') %></p>
  <p class="mt-4 text-[1.1rem] leading-relaxed text-gray-700 md:text-[1.3rem]"><%= t('privacy.intro') %></p>

  <% SECTIONS.forEach(function (s) { %>
    <div class="mt-10 border-t-2 border-gray-200 pt-6">
      <h2 class="text-[1.6rem] leading-tight md:text-[1.9rem]"><%= t(s.title) %></h2>
      <% if (s.text) { %>
        <p class="mt-2 text-[1.1rem] leading-relaxed text-gray-700"><%= t(s.text) %></p>
      <% } else { %>
        <ul class="mt-3 list-disc space-y-2 pl-6 text-[1.1rem] leading-relaxed text-gray-700">
          <% s.list.forEach(function (key) { %><li><%= t(key) %></li><% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>

  <div class="mt-10 flex flex-col gap-3 sm:flex-row">
    <a href="/call" class="btn"><%= t('privacy.call') %><i class="icon-phone" aria-hidden="true"></i></a>
    <a href="/settings" class="btn-plain"><%= t('privacy.settings') %></a>
  </div>
</section>

<%- include('partials/footer') %>
