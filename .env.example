NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# The first staff account. Created automatically on start if there are no staff yet.
# After that, add more staff from the admin area (Staff page).
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Which database to use: local or neon.
# Leave it empty on Render, where DATABASE_URL is used instead.
DB_TARGET=local

# Postgres on your own computer
LOCAL_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/seniorpadi
# Neon (copy from the Neon dashboard > Connect). SSL is switched on automatically.
NEON_DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Used when DB_TARGET is empty (Render sets this for you)
DATABASE_URL=

# Tests always use this one, and WIPE it every run. Never point it at real data.
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/seniorpadi_test

# Only for databases other than Neon that need SSL
DB_SSL=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@seniorpadi.org
BREVO_SENDER_NAME=SeniorPadi
BREVO_SMS_SENDER=SeniorPadi
# true = print emails and SMS in the terminal instead of sending them
NOTIFY_DRY_RUN=true

# shown to seniors who forget their password and have no email
SUPPORT_PHONE=0800 000 0000
